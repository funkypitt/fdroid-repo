{"repo": {"timestamp": 1789900804000, "version": 20002, "name": "funkypitt's F-Droid Repo", "icon": "icon.png", "address": "https://funkypitt.github.io/fdroid-repo/repo", "description": "Personal F-Droid repository with custom apps: Pluralis (alternative news aggregator) and OpenLibe Extended (e-ink library client)."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Sports & Health"], "suggestedVersionName": "1.1.2", "suggestedVersionCode": "4", "description": "Follow the guide round a square: breathe in, hold, out, hold. Four minutes, from a\n3-second rhythm to 4 seconds halfway. No settings, no streaks, no account, no\ntracking. English and French.\n", "issueTracker": "https://github.com/funkypitt/box-breathing/issues", "license": "GPL-3.0-only", "name": "Box Breathing 4min", "sourceCode": "https://github.com/funkypitt/box-breathing", "summary": "Four minutes of box breathing, nothing to set", "webSite": "https://github.com/funkypitt/box-breathing", "added": 1789753406000, "packageName": "com.freedomfighter.boxbreathing", "lastUpdated": 1789753406000, "localized": {"en-US": {"featureGraphic": "featureGraphic_h9epBtYSuV9MiBcIB5JM4DqlN6N1auntINhv7LHLIdw=.png", "icon": "icon_g1mZAa066RTI48_GAeVto5-zczS8cbCONJwrtBM0CT8=.png"}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Reading"], "suggestedVersionCode": "2147483647", "description": "Opens an issue as a contents page \u2014 one card per article, by section \u2014 then each\narticle on its own page, with previous / contents / next always on top. Made for\ndaily EPUB issues on e-ink. Ordinary books open as in Book's Story, which it forks.\n", "license": "GPL-3.0-only", "name": "ePub Magazine reader", "summary": "EPUB reader for newspaper and magazine issues", "added": 1789161087000, "packageName": "com.freedomfighter.magazinereader", "lastUpdated": 1789161087000, "localized": {"en-US": {"featureGraphic": "featureGraphic_J9fvhw6uS96CRwrohtHQkrm1WZ0LChn97y8O-mlceHk=.png", "icon": "icon_gpjZm8MpVFSBk9dLP1s1VzYDOpc7irSlMion4Kh47Hs=.png"}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Games"], "suggestedVersionCode": "38", "description": "4 in a Row, Caro, Awal\u00e9, Memory, Duck Chess, Tank Wars, Word Clash and Reversi\n(these also online, by room code); Tennis, Pool, Carrom, Air Hockey, Mini Golf, Star\nClash, Hangman, Horse Jump. Rules behind a ? in each game. No ads, no accounts, no\npurchases.\n", "issueTracker": "https://github.com/funkypitt/local-2p-games/issues", "license": "MIT", "name": "Funky's 2P Games", "sourceCode": "https://github.com/funkypitt/local-2p-games", "summary": "16 games for two on one phone, 8 also online", "webSite": "https://github.com/funkypitt/local-2p-games", "added": 1775056773000, "packageName": "com.local2p.games", "lastUpdated": 1789194266000, "localized": {"en-US": {"featureGraphic": "featureGraphic_ulYoDs0U9zqdJXP6vxkaeMKvBO6ShzfxT414DUr93vY=.png", "icon": "icon_aT07g_Ws3CDpcpSh2FsZBrFlAm3iC_r7K7_kyBRYRuw=.png", "phoneScreenshots": ["01-catalogue.png", "02-tennis.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Reading"], "suggestedVersionCode": "2147483647", "description": "Les 78 599 entr\u00e9es du dictionnaire d'\u00c9mile Littr\u00e9, avec \u00e9tymologies et citations,\nconsultables sans connexion. Recherche instantan\u00e9e, renvois cliquables, favoris, mot\ndu jour en widget. Ni publicit\u00e9 ni compte. Donn\u00e9es littre.org (Fran\u00e7ois Gannaz), CC\nBY-SA 3.0.\n", "issueTracker": "https://github.com/funkypitt/littre-app/issues", "license": "GPL-3.0-only", "name": "Le dictionnaire Littr\u00e9", "sourceCode": "https://github.com/funkypitt/littre-app", "summary": "Le Littr\u00e9 complet, hors ligne, sans publicit\u00e9", "webSite": "https://github.com/funkypitt/littre-app", "added": 1774267469000, "packageName": "ch.littre.littre_app", "lastUpdated": 1789161087000, "localized": {"en-US": {"featureGraphic": "featureGraphic_b9Wvz8G_LSNjJjYf5NGjg9L8c_x3Xy1xl9iRgnSfKug=.png", "icon": "icon_fiUwYSv_7lItXJ1Y5mX6tBwXJWop7hFcYRloC1BqBlA=.png", "phoneScreenshots": ["01-accueil-mot-du-jour.png", "02-article.png", "03-recherche.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Multimedia"], "suggestedVersionCode": "2147483647", "description": "Pick videos, or share them to the app: each becomes a 320 kbps MP3 (LAME) in\nDownloads, ready to share. One screen, whole batches, and it keeps going in the\nbackground. No network permission, no ads, no account.\n", "issueTracker": "https://github.com/funkypitt/mp4-to-mp3/issues", "license": "GPL-3.0-only", "name": "MP4 to MP3", "sourceCode": "https://github.com/funkypitt/mp4-to-mp3", "summary": "Turns videos into 320 kbps MP3 files, on the phone", "webSite": "https://github.com/funkypitt/mp4-to-mp3", "added": 1785398194000, "packageName": "app.mp4tomp3", "lastUpdated": 1789644177000, "localized": {"en-US": {"featureGraphic": "featureGraphic_2QX-jQRMliGkarIIum6oK0WbxPRCB88xfxk6mbmBeME=.png", "icon": "icon_0lmEIApPnLGmaUc4zT89zhjgS1Nj6rNxt9D5YDB20Ss=.png", "phoneScreenshots": ["01-accueil.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Reading"], "suggestedVersionName": "1.4.2", "suggestedVersionCode": "2024", "description": "Paginated EPUB reading with high-contrast themes and tap zones for e-paper, a local\nlibrary, and search in online catalogues. Fork of OpenLib Extended. The app hosts\nnothing; what you download is your responsibility.\n", "issueTracker": "https://github.com/funkypitt/funky-openlib/issues", "license": "AGPL-3.0-only", "name": "OpenLibe e-Ink Remix", "sourceCode": "https://github.com/funkypitt/funky-openlib", "summary": "E-ink e-book reader with library search", "webSite": "https://github.com/funkypitt/funky-openlib", "added": 1789161088000, "packageName": "com.freedomfighter.openlibeinkremix", "lastUpdated": 1789644178000, "localized": {"en-US": {"featureGraphic": "featureGraphic_2xtMsLCJiPUiDzbVBXvf1Zyp7HQt4SuXJtOCBrbDIlM=.png", "icon": "icon_Eb3RQyJ80WiuKCsG4zTV5-E7p_PpII5b5W0OC-Q-ro4=.png", "phoneScreenshots": ["01-bienvenue.png", "02-accueil.png"]}}}, {"authorName": "funkypitt", "categories": ["Multimedia"], "suggestedVersionCode": "12", "description": "Plays audio files and resumes each where it was left; speed 0.8\u20132\u00d7, lock-screen and\nBluetooth controls, a resume widget. Transcribes on the phone with whisper.cpp into\n.txt files any app opens \u2014 nothing is uploaded. Black and white, text only, six\nlanguages.\n", "issueTracker": "https://github.com/funkypitt/readers-audio/issues", "license": "MIT", "name": "Reader's Audio Player", "sourceCode": "https://github.com/funkypitt/readers-audio", "summary": "Plain audio player that transcribes on the phone", "webSite": "https://github.com/funkypitt/readers-audio", "added": 1789115559000, "packageName": "com.freedomfighter.readersaudio", "lastUpdated": 1789810056000, "localized": {"en-US": {"featureGraphic": "featureGraphic_DM5K3vzCmUJAbdSiLfDknaP1K3-JHK0p0xYCcY6kNnU=.png", "icon": "icon_0hWYw8vMAHWWNDAofdC7GI6S0g8URW5L05DtjTO4huc=.png", "phoneScreenshots": ["01-bibliotheque.png", "02-lecture.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Reading"], "suggestedVersionCode": "6", "description": "A shelf as a plain list; books as pages of text cut at whole lines, turned by a tap\n\u2014 made for e-ink. EPUB, MOBI, FB2, TXT; the place in each book is kept. No store, no\naccount, no network permission.\n", "issueTracker": "https://github.com/funkypitt/readers-books/issues", "license": "MIT", "name": "Reader's Books", "sourceCode": "https://github.com/funkypitt/readers-books", "summary": "Black-and-white e-book reader: pages, not scrolling", "webSite": "https://github.com/funkypitt/readers-books", "added": 1789027248000, "packageName": "com.freedomfighter.readersbooks", "lastUpdated": 1789161089000, "localized": {"en-US": {"featureGraphic": "featureGraphic_hRhvxeeKFy4yL9Wyq-IiBtdxo0mGElZTvkmJP-pqgZ0=.png", "icon": "icon_P82ghpAl9OfdkGg0pZL4froo8rd-mm29kugWVzr7yPs=.png", "phoneScreenshots": ["01-lecture.png", "02-etagere.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Reading"], "suggestedVersionCode": "3", "description": "Searches Project Gutenberg, Standard Ebooks, Wikisource, Biblioth\u00e8que num\u00e9rique\nromande, Ebooks libres et gratuits, textos.info and the Internet Archive at once;\nAnna's Archive only if you turn it on. Says whether the author has been dead seventy\nyears when the source gives the dates. Downloads the file and leaves the reading to\nyour reader. Hosts nothing, no account. Black and white, text only.\n", "issueTracker": "https://github.com/funkypitt/readers-bookshop/issues", "license": "MIT", "name": "Reader's Bookshop", "sourceCode": "https://github.com/funkypitt/readers-bookshop", "summary": "Finds free e-books across the public-domain libraries", "webSite": "https://github.com/funkypitt/readers-bookshop", "added": 1789285726000, "packageName": "com.freedomfighter.readersbookshop", "lastUpdated": 1789894101000, "localized": {"en-US": {"featureGraphic": "featureGraphic_04PGg98_drqyNKRljNB8ncttAxljlk3G_cjso19sKi8=.png", "icon": "icon_qdBudOJvgLXOchG1IfMCH7F-UhiBlorZCuK1CzSwYeo=.png", "phoneScreenshots": ["01-telechargements.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Time"], "suggestedVersionCode": "21", "description": "Shows the calendars the phone already syncs (Google, Infomaniak, Nextcloud\u2026) as\nplain text: agenda, month, week, day. No colour codes \u2014 an event's calendar is named\nin words. Create, edit, repeat, remind, drag to move. No account or network of its\nown.\n", "license": "MIT", "name": "Reader's Calendar", "sourceCode": "https://github.com/funkypitt/readers-calendar", "summary": "Black-and-white, text-only calendar", "added": 1788809892000, "packageName": "com.freedomfighter.readerscalendar", "lastUpdated": 1789717337000, "localized": {"en-US": {"featureGraphic": "featureGraphic_FF7DzWHll29sEWm1FO__XRqTRcFLAowYh_zqWiK2KDQ=.png", "icon": "icon_HsD3tiA3D_lF8G_Jgv17T4qBfs9Tgg1SDtIOyiRKZeY=.png", "phoneScreenshots": ["01-semaine.png", "02-menu.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Internet"], "suggestedVersionCode": "9", "description": "Blocks YouTube, Instagram, TikTok, Reddit, X and Substack outside the hours you\nallow. The filtering happens on the device: no proxy, no certificate, no account.\nWhile it blocks, sites and hours are locked, and five maths problems can stand\nbetween you and stopping it. Friction you choose, not parental control. Works on\nIPv6-only carriers. Black and white, text only, six languages.\n", "issueTracker": "https://github.com/funkypitt/SocialBlocker-Detox/issues", "license": "GPL-3.0-only", "name": "Reader's Detox", "sourceCode": "https://github.com/funkypitt/SocialBlocker-Detox", "summary": "Blocks social networks on the phone with a local DNS VPN", "added": 1780252742000, "packageName": "com.parentcontrol.socialblocker.detox", "lastUpdated": 1789714968000, "localized": {"en-US": {"featureGraphic": "featureGraphic_9W6L-53lwAscLARwAUKNLn_YBRoc_lOf2IU_B5gKwqs=.png", "icon": "icon_zZIq01encIQ1rPzRw91Log86zdut8sxXYg9IOADQPvQ=.png", "phoneScreenshots": ["01-accueil.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Reading", "Internet"], "suggestedVersionCode": "2006", "description": "Your RSS and Atom sources as one plain list, articles read as pages cut at whole\nlines \u2014 no scrolling, for e-ink. OPML, saved articles, paid Substacks. No icons, no\ncolours, no account. Fork of Pluralis.\n", "issueTracker": "https://github.com/funkypitt/readers-feeds/issues", "license": "GPL-3.0-only", "name": "Reader's Feeds", "sourceCode": "https://github.com/funkypitt/readers-feeds", "summary": "Black-and-white, text-only RSS reader", "webSite": "https://github.com/funkypitt/readers-feeds", "added": 1788847786000, "packageName": "com.freedomfighter.readersfeeds", "lastUpdated": 1789651044000, "localized": {"en-US": {"featureGraphic": "featureGraphic_8Q7hGAx6dkluJOkNVKBe9xg7CnLchMqc6yX-jLgTtX0=.png", "icon": "icon_vuxX7TQ6cFQiVacdMk0Jlli3NEVTaEyesewc2Taojdg=.png", "phoneScreenshots": ["01-articles.png", "02-article.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Sports & Health"], "suggestedVersionCode": "3", "description": "One touch photographs what you are about to eat; the app labels it breakfast, lunch,\ndinner or snack and files it by day. No calories, no database, no typing. Activity\nin one tap, weight once a day with its curve. No network permission; the journal\nexports as a zip.\n", "issueTracker": "https://github.com/funkypitt/readers-foodlog/issues", "license": "MIT", "name": "Reader's Food Log", "sourceCode": "https://github.com/funkypitt/readers-foodlog", "summary": "A food journal made of photos", "webSite": "https://github.com/funkypitt/readers-foodlog", "added": 1789857507000, "packageName": "com.freedomfighter.readersfoodlog", "lastUpdated": 1789859493000, "localized": {"en-US": {"featureGraphic": "featureGraphic_nH-EnhD8nMPza7Dh8WAfKwbQ5ImghAhLWIUwsoei4iE=.png", "icon": "icon_ES1G_rDdDJhVKusRTlI6aCBObrNM3sGbUjPQcYLpUGI=.png"}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["System"], "suggestedVersionCode": "32", "description": "The home screen is one fixed page of words: no icons, no colours, no wallpaper. Text\ntiles for apps and categories; built-in clock, weather (MeteoSwiss or Open-Meteo, no\nkey), agenda, tasks and notes; two books a swipe away. Swipe up for all apps, down\nfor notifications. No ads, no tracking. Six languages.\n", "license": "MIT", "name": "Reader's Launcher", "sourceCode": "https://github.com/funkypitt/readers-launcher", "summary": "Black-and-white, text-only launcher in the spirit of the Light Phone", "added": 1788624054000, "packageName": "com.freedomfighter.readerslauncher", "lastUpdated": 1789885444000, "localized": {"en-US": {"featureGraphic": "featureGraphic_KrlAQJ0z7LjOng7ptkKm5I-cmvXxe_SNyspvLW19Vuw=.png", "icon": "icon_5bBQux5dxFl_tCyS3etkDNW4LEpvWIUcP_yJ4FvD5zU=.png", "phoneScreenshots": ["01-accueil.png", "02-noir-sur-blanc.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Time"], "suggestedVersionCode": "2", "description": "Three things a meditator asks of a bowl: a strike every X minutes, a sitting of X\nminutes closed by three bowls, bowls at set times each day. Rung as exact alarms, so\nthey sound through Doze and silent mode. Five bowls or your own file. No streaks, no\nguidance, no account.\n", "issueTracker": "https://github.com/funkypitt/readers-mindful/issues", "license": "MIT", "name": "Reader's Mindful Tool", "sourceCode": "https://github.com/funkypitt/readers-mindful", "summary": "A bowl every X minutes, a timed sitting, bowls at set times", "webSite": "https://github.com/funkypitt/readers-mindful", "added": 1789030921000, "packageName": "com.freedomfighter.readersmindful", "lastUpdated": 1789161090000, "localized": {"en-US": {"featureGraphic": "featureGraphic_rYS2reFQ7p2UwUb48dw1_mdfdLx1RE5ZDC87r0XPrgA=.png", "icon": "icon_zZW-EYYjpSHIXllgK_omSvZ0GXhwHrTjILWL38mvU8I=.png", "phoneScreenshots": ["01-reglages.png", "02-bol-en-cours.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Writing"], "suggestedVersionCode": "9", "description": "One list, one page: a note is a .txt file whose first line is its title. Type it or\ndictate it \u2014 speech is written on the phone by whisper.cpp, nothing is uploaded.\nOptional two-way sync with your own WebDAV folder (kDrive, Nextcloud\u2026). No\nformatting, no folders, no account.\n", "issueTracker": "https://github.com/funkypitt/readers-notes/issues", "license": "MIT", "name": "Reader's Notes", "sourceCode": "https://github.com/funkypitt/readers-notes", "summary": "Black-and-white plain-text notes, typed or dictated, WebDAV sync", "webSite": "https://github.com/funkypitt/readers-notes", "added": 1789027249000, "packageName": "com.freedomfighter.readersnotes", "lastUpdated": 1789894101000, "localized": {"en-US": {"featureGraphic": "featureGraphic_owSdO45-suKo8XgPbiauGVGx2h2NKnq3P31wrmtWJxY=.png", "icon": "icon_Ja5e7CACyVEfRxgLV9NCx4O9SgZZV-WZScl3H3cto_Q=.png", "phoneScreenshots": ["01-liste.png", "02-note.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Multimedia"], "suggestedVersionCode": "15", "description": "Channels, episodes, favourites, downloads: four plain lists, no artwork. Feeds are\nadded by pasting or sharing a link, and an episode resumes where you stopped. It can\nbe transcribed and translated on the phone, and read while it plays. No directory,\nno recommendations, no account: OPML and one settings file are the whole sync with\nthe desktop twin.\n", "issueTracker": "https://github.com/funkypitt/readers-podcasts/issues", "license": "MIT", "name": "Reader's Podcasts", "sourceCode": "https://github.com/funkypitt/readers-podcasts", "summary": "Text-only podcast player: subscribe, download, listen", "webSite": "https://github.com/funkypitt/readers-podcasts", "added": 1789734674000, "packageName": "com.freedomfighter.readerspodcasts", "lastUpdated": 1789847229000, "localized": {"en-US": {"featureGraphic": "featureGraphic_xr0L1_C_GE8K_Bm_sJy7AukhggeN_ukoMemT0XIU-a8=.png", "icon": "icon_0hWYw8vMAHWWNDAofdC7GI6S0g8URW5L05DtjTO4huc=.png", "phoneScreenshots": ["01-episodes.png", "02-lecture.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Multimedia"], "suggestedVersionCode": "20", "description": "One tap records a memo, a lecture or a conversation, screen off included. The phone\nitself writes the transcript (whisper.cpp), evens the loudness and can list the main\npoints (beta) \u2014 nothing leaves it. Optional export to your own WebDAV folder. Text\nonly, six languages.\n", "issueTracker": "https://github.com/funkypitt/readers-recorder/issues", "license": "MIT", "name": "Reader's Recorder", "sourceCode": "https://github.com/funkypitt/readers-recorder", "summary": "Black-and-white voice recorder that transcribes on the phone", "webSite": "https://github.com/funkypitt/readers-recorder", "added": 1789107222000, "packageName": "com.freedomfighter.readersrecorder", "lastUpdated": 1789810056000, "localized": {"en-US": {"featureGraphic": "featureGraphic_EpIHqUmDkAK9r1t6wBKnnFqQgxFQOV9uEnZI-0HTo7w=.png", "icon": "icon_-VnDdz1ugyN-vNt5W0uXVl9vUDLM1ykgq-XXm7eEVqM=.png", "phoneScreenshots": ["01-enregistrements.png", "02-fiche.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Writing"], "suggestedVersionCode": "8", "description": "The open tasks of your CalDAV lists (Nextcloud, Infomaniak, Tasks.org, Radicale\u2026) as\nplain text. Tick to complete, one line to add, long press for the rest. No\npriorities, no projects, no account with the app: your server, your password, on the\nphone only. Feeds the tasks tile of Reader's Launcher.\n", "license": "MIT", "name": "Reader's Tasks", "sourceCode": "https://github.com/funkypitt/readers-tasks-android", "summary": "Black-and-white, text-only CalDAV task lists", "added": 1788776362000, "packageName": "com.freedomfighter.readerstasks", "lastUpdated": 1789722082000, "localized": {"en-US": {"featureGraphic": "featureGraphic_xDxIbfU4gXtMDJF33uzjOiFfTNPLRO2gsbn-EBXVd44=.png", "icon": "icon_wFeSKd5T1xcS_JXitL3kFLiwfQy6xCKXy5ZYkoSz3T4=.png"}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Multimedia"], "suggestedVersionCode": "8", "description": "Talks, bells and chanting for a meditation retreat, loaded from the phone, a public\nkDrive link or a podcast feed and kept in the app \u2014 airplane mode is fine. Playback\nholds a wake lock and the screen; a recording plays once, and nothing follows it. No\nads, no account.\n", "license": "MIT", "name": "Retreat Player", "sourceCode": "https://github.com/funkypitt/retreat-player", "summary": "Plays retreat recordings offline; nothing can interrupt them", "added": 1784030307000, "packageName": "com.freedomfighter.retreatplayer", "lastUpdated": 1789161091000, "localized": {"en-US": {"featureGraphic": "featureGraphic_cCYLTrFbzGWOb_We10BlpWvorfr0IOKj9Lz3z47J9gc=.png", "icon": "icon_FcfrtMoQ2CgaftD_buZQPniBhuMf6hJiit9nIXr5kjE=.png"}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Time"], "suggestedVersionCode": "21", "description": "Set the times of day; one bell or three ring at each, every day, so a retreat runs\nwith no one at the bell. Exact alarms and a foreground service: they ring through\nlock, Doze and reboot, and a light says when the phone is ready. Five bowls at\nmatched loudness or your own sound, and talks scheduled like bells. No ads, no\naccount.\n", "license": "MIT", "name": "Retreat Timer", "sourceCode": "https://github.com/funkypitt/retreat-timer", "summary": "Rings meditation bells on schedule, even in deep sleep", "added": 1782379054000, "packageName": "com.freedomfighter.retreattimer", "lastUpdated": 1789161091000, "localized": {"en-US": {"featureGraphic": "featureGraphic_iq9GaBhHrNCQhG653ck-HlvenD_QXBEzJPqsdmKuN4M=.png", "icon": "icon_SgaFBSx5Q2n6I2NAkqxpvgeL7z0Xd-W9bTWV_69E5Dg=.png", "phoneScreenshots": ["01-horaire.png", "02-bibliotheque.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Time"], "suggestedVersionCode": "3", "description": "One number, one button. For switching partners in paired practice, or a regular call\nback to the present. Exact alarms timed from the start of the session, so the bells\nneither drift nor miss in Doze. No network permission.\n", "issueTracker": "https://github.com/funkypitt/retreat-walk/issues", "license": "MIT", "name": "Retreat Walk", "sourceCode": "https://github.com/funkypitt/retreat-walk", "summary": "Rings a bowl every so many minutes, until you stop it", "added": 1785406002000, "packageName": "com.freedomfighter.retreatwalk", "lastUpdated": 1789742378000, "localized": {"en-US": {"featureGraphic": "featureGraphic_R3ZIQtRV_VGL7qHQcj7efI6nUh8mOFgZjVJ35kcGShY=.png", "icon": "icon_mKLMtTXWxT9kmX8UcyhSYp369m2eqSIYqTEmuVYltS8=.png", "phoneScreenshots": ["01-reglage.png", "02-en-marche.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Multimedia", "Internet"], "suggestedVersionCode": "2147483647", "description": "Plays the sound of the channels you follow, and nothing else: no video, no\nthumbnails, no recommendations, no Shorts, no comments. A chronological list in\nplain text; chapters, speed, downloads, background play. No account, no tracking.\nBuilt on NewPipeExtractor; not affiliated with YouTube.\n", "license": "GPL-3.0-only", "name": "Sobre", "sourceCode": "https://github.com/funkypitt/sobre", "summary": "YouTube subscriptions as audio only, all text", "webSite": "https://github.com/funkypitt/sobre", "added": 1780233268000, "packageName": "app.sobre.player", "lastUpdated": 1789810057000, "localized": {"en-US": {"featureGraphic": "featureGraphic_3WCIGZdpjMvJ3IfCd8kPYnEvI5FQirZ4pO9SXYsyk9Y=.png", "icon": "icon_AHeaQdv1Pnc4QoDP2ZTsK2IK4wCj1NSisFJ0dN-x8-U=.png"}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["Games"], "suggestedVersionCode": "2147483647", "description": "The DOS artillery game by Kenneth Morse: angle, power, wind, no trajectory preview.\n16 weapons, 3 defences, destructible terrain. Hot-seat on one phone, or online. No\nads, no purchases.\n", "issueTracker": "https://github.com/funkypitt/tankwars-mobile/issues", "license": "MIT", "name": "Tank Wars Mobile", "sourceCode": "https://github.com/funkypitt/tankwars-mobile", "summary": "Tank Wars (1992) rebuilt for touchscreens, two players", "webSite": "https://github.com/funkypitt/tankwars-mobile", "added": 1789753406000, "packageName": "com.freedomfighter.tankwars", "lastUpdated": 1789753406000, "localized": {"en-US": {"featureGraphic": "featureGraphic_5MCL54ua9xLLfznv3moQrkhjvvBoc0uDdGmgdFjAl_0=.png", "icon": "icon_Qdu-VyL2icsHuLxDvqjnFiMcKsL9Yr4WP99dCytoCQo=.png", "phoneScreenshots": ["01-titre.png", "02-partie.png"]}}}, {"authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "categories": ["System"], "suggestedVersionCode": "2147483647", "description": "Tap when the machine goes on the stove, tap when coffee appears, tap when done:\nheating time, then extraction with the 25\u201330 s zone marked, then grind advice.\nVibrates at 25 s, 30 s and 8 min; the screen stays on. Unofficial, not affiliated\nwith 9Barista Ltd. No network, no ads.\n", "license": "MIT", "name": "Timer for 9Barista", "summary": "Espresso timer for the 9Barista, three taps per brew", "added": 1781014819000, "packageName": "com.freedomfighter.baristatimer", "lastUpdated": 1789161092000, "localized": {"en-US": {"featureGraphic": "featureGraphic_BL2i7WaMyNDT_f_Ys9d_ccNVsPor6D2H37G5xiBo1IM=.png", "icon": "icon_g2h6A5biQyT67-ihth09oZlmj0C6edd_1GVqsqV9_no=.png", "phoneScreenshots": ["01-accueil.png"]}}}], "packages": {"app.mp4tomp3": [{"added": 1789644177000, "apkName": "MP4-to-MP3-v1.0.2.apk", "hash": "645d8e533e7da197768a02a55e6f85eac72d5743ea15f412a9a705d7068154c0", "hashType": "sha256", "minSdkVersion": 29, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86_64"], "packageName": "app.mp4tomp3", "sig": "a68c2003a134da7235605d8da889d3dc", "signer": "9b6