y": {"en-US": "ePub reader tuned for daily newspaper / magazine issues"}, "description": {"en-US": "Fork of Book's Story (ua.acclorite.book_story) with an opinionated\nmagazine-mode parser and TOC for ePub issues produced by the in-house\nnewsletter generator (NZZ, 24 heures, Courrier International, Economist\nfixtures).\n\nDetects magazine ePubs at open time, paginates the table of contents\nwith one card per article (category, title, optional cover image),\nand routes tap → article view rendered by an in-zip WebView.\n\nA permanent three-zone navigation header (prev / home / next) sits on\ntop of the existing tap-zone gesture system on every magazine screen.\n\nInstalls next to upstream Book's Story under its own application id\n(com.freedomfighter.magazinereader since 0.2.24; the earlier\nua.acclorite.book_story.debug builds must be uninstalled by hand).\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"d37a5211ff24365507e1a1f47fbeeaa98c59f57a8ba63f77b5508845726409d8": {"added": 1789161087000, "file": {"name": "/MagazineReader-v0.2.24-magazine.apk", "sha256": "d37a5211ff24365507e1a1f47fbeeaa98c59f57a8ba63f77b5508845726409d8", "size": 21783564}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.2.24-magazine", "versionCode": 39, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.FOREGROUND_SERVICE"}]}}}}, "com.freedomfighter.openlibeinkremix": {"metadata": {"added": 1789161088000, "categories": ["Reading"], "issueTracker": "https://github.com/funkypitt/funky-openlib/issues", "lastUpdated": 1789161088000, "license": "AGPL-3.0-only", "so