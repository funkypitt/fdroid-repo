        "name": {
          "en-US": "Box Breathing 4min"
        },
        "summary": {
          "en-US": "Minimalist 4-minute guided box breathing exercise"
        },
        "description": {
          "en-US": "A calming, distraction-free breathing exercise app. Follow the\nanimated guide around a square: breathe in, hold, breathe out, hold.\nThe 4-minute session starts with a 3-second rhythm and gently\ntransitions to 4 seconds halfway through. Bilingual instructions\n(English / French). No accounts, no ads, no tracking.\n"
        },
