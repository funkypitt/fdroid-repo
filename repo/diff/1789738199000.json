    "com.freedomfighter.tankwars": {
      "metadata": {
        "added": 1789753406000,
        "categories": [
          "Games"
        ],
        "issueTracker": "https://github.com/funkypitt/tankwars-mobile/issues",
        "lastUpdated": 1789753406000,
        "license": "MIT",
        "sourceCode": "https://github.com/funkypitt/tankwars-mobile",
        "webSite": "https://github.com/funkypitt/tankwars-mobile",
        "featureGraphic": {
          "en-US": {
            "name": "/com.freedomfighter.tankwars/en-US/featureGraphic_5MCL54ua9xLLfznv3moQrkhjvvBoc0uDdGmgdFjAl_0=.png",
            "sha256": "e4c08be78b9af712cb7f39efde6a10ae4863bef068734b837469a07458c097fd",
            "size": 52076
          }
        },
        "authorName": "Pierre Gallaz",
        "authorWebSite": "https://gallaz.ch/eink",
        "name": {
          "en-US": "Tank Wars Mobile"
        },
        "summary": {
          "en-US": "Classic artillery game rebuilt for mobile. 2-player local and online."
        },
        "description": {
          "en-US": "Tank Wars Mobile is a faithful recreation of the classic DOS artillery game\nTank Wars 3.2 (1992) by Kenneth Morse, rebuilt from the ground up for mobile\ntouchscreens.\n\nTwo players take turns aiming their tanks and firing an arsenal of weapons at\neach other across randomly generated destructible terrain. Judge the angle,\npower, and wind to land your shots — there's no trajectory preview, so every\nshot is a test of skill and intuition.\n\n16 weapons including nukes, MIRVs, lasers, and chain reaction inducers.\n3 defense systems: shields, inertia dampeners, and repulsers.\n6 wall types, 5 wind levels, destructible terrain with crumbling.\nLocal 2-player hot-seat and online multiplayer via Firebase.\n\nFree and open source. No ads. No tracking. No in-app purchases.\n"
        },
        "icon": {
          "en-US": {
            "name": "/com.freedomfighter.tankwars/en-US/icon_Qdu-VyL2icsHuLxDvqjnFiMcKsL9Yr4WP99dCytoCQo=.png",
