ta": {"added": 1789734674000, "categories": ["Multimedia"], "issueTracker": "https://github.com/funkypitt/readers-podcasts/issues", "lastUpdated": 1789740973000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-podcasts", "webSite": "https://github.com/funkypitt/readers-podcasts", "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Podcasts"}, "summary": {"en-US": "Podcasts in black and white — subscribe, download, listen, nothing else"}, "description": {"en-US": "A podcast player with nothing on the screen but lines of text. Subscribe by pasting the\naddress of a feed or by sharing a link to the app; the episodes wait in one of three lists —\nwhat is on the phone or already begun, what is new across all the channels, or one channel at\na time. An episode is downloaded or played straight over the connection, resumes exactly where\nit was left, and once heard through is marked and its file let go.\n\nSubscriptions travel as OPML, which any podcast app reads, and the settings — with the place\neach episode was left — as a JSON file. Those two files are the whole of the synchronisation\nwith the desktop twin: there is no server and no account, and nothing leaves the phone but the\nrequests to the feeds themselves.\n\nEnglish, French, German, Spanish, Portuguese and Russian; white on black or black on white,\nthree fonts, three text sizes.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"8f6ed16599d4704e8c8e8649325a012abeddf379fcc181dba13a806b8b3e8de1": {"added": 1789740973000, "file": {"name": "/ReadersPodcasts-v0.1.3.apk", "sha256": "8f6ed16599d4704e8c8e8649325a012abeddf379fcc181dba13a806b8b3e8de1", "size": 20674283}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.3", "versionCode": 4, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1