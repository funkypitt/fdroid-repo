{"repo": {"timestamp": 1788845079000}, "packages": {"com.freedomfighter.readersbooks": {"metadata": {"added": 1788845077000, "categories": ["Reading"], "issueTracker": "https://github.com/funkypitt/readers-books/issues", "lastUpdated": 1788845077000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-books", "webSite": "https://github.com/funkypitt/readers-books", "authorName": "funkypitt", "name": {"en-US": "Reader's Books"}, "summary": {"en-US": "Black-and-white e-book reader with a shelf"}, "description": {"en-US": "A shelf of books as a plain list, and pages of plain text cut at whole\nlines. EPUB, MOBI, FB2 and text files, opened from the app, a file manager\nor a share. Tap halves to turn pages, long press for chapters and text\nsize. Position remembered per book. White on black or black on white.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"dab78f048c0cb92cbb4ebe59e8ee8ed5ba3af634cc2b3dda2f0d25ef98a2bdd3": {"added": 1788845077000, "file": {"name": "/ReadersBooks-v1.0.0.apk", "sha256": "dab78f048c0cb92cbb4ebe59e8ee8ed5ba3af634cc2b3dda2f0d25ef98a2bdd3", "size": 8146914}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readersbooks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerscalendar": {"metadata": {"added": 1788809892000, "categories": ["Time"], "lastUpdated": 1788814072000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-calendar", "authorName": "funkypitt", "name": {"en-US": "Reader's Calendar"}, "summary": {"en-US": "Black-and-white, text-only calendar"}, "description": {"en-US": "Reader's Calendar shows the phone's own calendars — the ones your accounts already\nsync (Google, Infomaniak, Nextcloud…) — as plain text, white on black or black on\nwhite. No colour codes: the calendar an event belongs to is named in a quiet line of\ntext on the event's page.\n\n* Agenda: the coming days as a list. Month: a grid of numbers, a dot for days with\n  events, today inverted. Week: a list in portrait, a time grid in landscape.\n* Event page with location and description; create and edit events with reminder,\n  repetition, all-day, calendar choice.\n* Landscape puts the month grid beside the agenda and splits event pages in two.\n* Can be the default calendar app, including for Reader's Launcher's agenda tile.\n\nSerif, sans or monospace; three text sizes. No account, no network of its own.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"68b1cdd07fbd9e470a1589a30a98265749b7bba1a6be9eeb20c3763ea80e4bae": {"added": 1788814072000, "file": {"name": "/ReadersCalendar-v1.2.1.apk", "sha256": "68b1cdd07fbd9e470a1589a30a98265749b7bba1a6be9eeb20c3763ea80e4bae", "size": 8125757}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.1", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerscalendar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "44305395b83e7a18fc7bde874df2acc58e8c2e050c5b5313a10a128cd7a9ddc8": {"added": 1788809892000, "file": {"name": "/ReadersCalendar-v1.0.0.apk", "sha256": "44305395b83e7a18fc7bde874df2acc58e8c2e050c5b5313a10a128cd7a9ddc8", "size": 8617177}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersi