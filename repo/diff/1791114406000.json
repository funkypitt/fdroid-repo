{"repo": {"timestamp": 1791321146000}, "packages": {"com.freedomfighter.magazinereader": {"metadata": {"lastUpdated": 1791320950000}, "versions": {"6c292598adb5e2e66c0efdfc3a985d091d672213637adecb09e2af5bef023527": null, "9e5dff78c85fb53957ab468def21ceedc679bf5b0e4f583182c3bdb72f3fcf77": {"added": 1791320950000, "file": {"name": "/MagazineReader-v0.2.27-magazine.apk", "sha256": "9e5dff78c85fb53957ab468def21ceedc679bf5b0e4f583182c3bdb72f3fcf77", "size": 21808196}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.2.27-magazine", "versionCode": 42, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.FOREGROUND_SERVICE"}]}}}}, "com.freedomfighter.readersbooks": {"metadata": {"lastUpdated": 1791320950000, "description": {"en-US": "A shelf as a plain list; books as pages of text cut at whole lines, turned by a tap\n— made for e-ink. EPUB, MOBI, FB2, TXT; the place in each book is kept. No store, no\naccount; the network is used only for the optional library on your own drive (kDrive\nshare link or WebDAV), listed by folder, a book downloaded when tapped.\n"}}, "versions": {"74e808a8bf8b8c2bb89a90fc991e5fd21e2f64db41ddfd206ff1d757e6bcd7ce": null, "6755b995b69a0801b07868e7b31e1b4f80dd3f16da22c27dd567b1da61247579": {"added": 1791320950000, "file": {"name": "/ReadersBooks-v1.5.0.apk", "sha256": "6755b995b69a0801b07868e7b31e1b4f80dd3f16da22c27dd567b1da61247579", "size": 6091461}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.5.0", "versionCode": 10, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readersbooks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersnotes": {"metadata": {"lastUpdated": 1791281288000}, "versions": {"ae1de6a50f54596e3d27de5b0ab7c43fa4c702a49de71953e520b98cd664b3d4": null, "990e0f03091d5eeb5ddbc8cb30e1cbe74ab1146223c21face6393499d3dca11d": {"added": 1791281288000, "file": {"name": "/ReadersNotes-v1.7.0.apk", "sha256": "990e0f03091d5eeb5ddbc8cb30e1cbe74ab1146223c21face6393499d3dca11d", "size": 13206649}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.7.0", "versionCode": 13, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "com.freedomfighter.readersnotes.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersphone": {"metadata": {"added": 1791212565000, "categories": ["Phone & SMS"], "lastUpdated": 1791281568000, "license": "MIT", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersphone/en-US/featureGraphic_xUXdGKMF_Oo7HseanQU7ZhCwYtYLEPpGRhPtivZiPQM=.png", "sha256": "c545dd18a305fcea3b1ec79a9d053b6610b062d60b10fa464613ed8af6623d03", "size": 24889}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Phone"}, "summary": {"en-US": "A phone in large type, two colours, that can record a call and write it out"}, "description": {"en-US": "A call rings on the whole screen with the person's photo and name and two big buttons;\nmissed calls stay at the top until answered with \"call back\" or \"OK\". Contacts read\nfavourites, then the people called lately, then everyone; a keypad with large keys; the\nlist of calls. Leave the call for another app and it stays in view: Android's own call\nnotification with one big \"hang up\", and a wide green band that brings the call back.\n\nRecording (off by default): a call is recorded and written out on the phone by\nwhisper.cpp, the model fetched once and shared with the other Reader's apps. Android only\ngives the sound of a call to an accessibility service, so one has to be switched on; the\nsettings say so. Tell the other person — in many countries the law requires it.\n\nSix languages. No account; the network is used only to fetch the model.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersphone/en-US/icon_Y9JU0_KVDzdiHH9dd1fv2tnocRUWvD-uJ0x_Wm2PkLA=.png", "sha256": "63d254d3f2950f37621c7f5d7757efdad9e8711516bc3fae274c7f5a6d8f90b0", "size": 4196}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"e73ccb52e5f7969e7f49a757cabbebbde00057ff80465c34cc79385f0d8871b8": {"added": 1791281568000, "file": {"name": "/ReadersPhone-v1.1.0.apk", "sha256": "e73ccb52e5f7969e7f49a757cabbebbde00057ff80465c34cc79385f0d8871b8", "size": 30619325}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 3, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_PHONE_CALL"}, {"name": "android.permission.MANAGE_OWN_CALLS"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readersphone.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tchitchi.phone": {"metadata": {"lastUpdated": 1791281568000, "description": {"en-US": "The phone of the Tchitchi launcher as an app of its own, for a phone that keeps its\nlauncher. A call rings on the whole screen with the caller's photo and name in large type\nand two big buttons; missed calls stay at the top until answered with \"call back\" or \"OK\".\nContacts read favourites, then the people called lately, then everyone, with a search\nfield; a keypad with large keys; the list of calls. When another app is opened during a\ncall, a wide green band stays at the top of the screen with the name and the time on the\nline, and a touch brings the call back. Twelve themes. No account, no network,\nnothing leaves the phone.\n"}}, "versions": {"3b63dd00bcdaa0e5624ef6b28c91d4eae0e1ea8ef5b6a07c4d2e1d77a3c68e98": null, "b282044bcd2c5342f33c7b1b015cf6bfcff8d1220c4cbdbc0261a75fdbc8f997": {"added": 1791281568000, "file": {"name": "/TchitchiPhone-v1.2.0.apk", "sha256": "b282044bcd2c5342f33c7b1b015cf6bfcff8d1220c4cbdbc0261a75fdbc8f997", "size": 6091842}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_PHONE_CALL"}, {"name": "android.permission.MANAGE_OWN_CALLS"}, {"name": "com.freedomfighter.tchitchi.phone.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}