IONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerspodcasts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tankwars": {"metadata": {"added": 1789753406000, "categories": ["Games"], "issueTracker": "https://github.com/funkypitt/tankwars-mobile/issues", "lastUpdated": 1789753406000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/tankwars-mobile", "webSite": "https://github.com/funkypitt/tankwars-mobile", "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Tank Wars Mobile"}, "summary": {"en-US": "Classic artillery game rebuilt for mobile. 2-player local and online."}, "description": {"en-US": "Tank Wars Mobile is a faithful recreation of the classic DOS artillery game\nTank Wars 3.2 (1992) by Kenneth Morse, rebuilt from the ground up for mobile\ntouchscreens.\n\nTwo players take turns aiming their tanks and firing an arsenal of weapons at\neach other across randomly generated destructible terrain. Judge the angle,\npower, and wind to land your shots — there's no trajectory preview, so every\nshot is a test of skill and intuition.\n\n16 weapons including nukes, MIRVs, lasers, and chain reaction inducers.\n3 defense systems: shields, inertia dampeners, and repulsers.\n6 wall types, 5 wind levels, destructible terrain with crumbling.\nLocal 2-player hot-seat and online multiplayer via Firebase.\n\nFree and open source. No ads. No tracking. No in-app purchases.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"373a5ab7294e0d8ab6bad1d4c298a8c3808581fe3aa10b84be1fa4dd0ac3c1e1": {"added": 1789753406000, "file": {"name": "/TankWars-v1.1.1.apk", "sha256": "373a5ab7294e0d8ab6bad1d4c298a8c3808581fe3aa10b84be1fa4dd0ac3c1e1", "size": 3439942}, "manifest": {"versionName": "1.1.1", "versionCode": 111, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256