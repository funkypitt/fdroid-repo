IONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_PHONE_CALL"}, {"name": "android.permission.MANAGE_OWN_CALLS"}, {"name": "com.freedomfighter.tchitchi.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.parentcontrol.socialblocker.detox": {"metadata": {"lastUpdated": 1792052606000, "description": {"en-US": "Blocks YouTube, Instagram, TikTok, Reddit, X and Substack outside the hours you\nallow. The filtering happens on the device: no proxy, no certificate, no account.\nWhile it blocks, sites and hours are locked, and five maths problems can stand\nbetween you and stopping it. A daily budget of minutes in the sites' apps, then\nblocked until midnight. Friction you choose, not parental control. Works on\nIPv6-only carriers. Black and white, text only, six languages.\n\nOnly the names of the sites you look up pass through the app, never the traffic\nitself. They go to your network's own name servers as usual; if those do not\nanswer, the app asks Quad9, a Swiss non-profit name service, so that the phone\nkeeps working.\n"}}, "versions": {"5b07b8329ae04d35c0c26d8c457aee0c6bad980d2513f362f438d5858f7b9ece": null, "c0e9e37cf2c4c3defcdb62f1a4171b8a5bb4da0f5fa76de14c39346aef20955a": {"added": 1792052606000, "file": {"name": "/SocialDetox-v1.8.0-detox.apk", "sha256": "c0e9e37cf2c4c3defcdb62f1a4171b8a5bb4da0f5fa76de14c39346aef20955a", "size": 5243246}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.8.0-detox", "versionCode": 12, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SER