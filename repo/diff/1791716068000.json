{"repo": {"timestamp": 1792052608000}, "packages": {"com.freedomfighter.readersattention": {"metadata": {"added": 1791721595000, "categories": ["System"], "issueTracker": "https://github.com/funkypitt/readers-attention/issues", "lastUpdated": 1792052606000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-attention", "webSite": "https://github.com/funkypitt/readers-attention", "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/apps", "name": {"en-US": "Reader's Attention"}, "summary": {"en-US": "The apps opened by reflex, counted in words, with a pause before them"}, "description": {"en-US": "Not the screen time but the use to no purpose: the apps opened by reflex (social\nnetworks, games, short video). Each day, in words: how many times they were opened and\nfor how long, what came first after unlocking, the longest stretch, the evening, the\nquick checks under a minute. A tap moves any app between \"reflex\" and \"tools\". Off by\ndefault and never blocking: a pause before a reflex app asks \"what for?\" and waits a few\nseconds (longer in the evening, or with the reason typed), then leaves the app alone for\nten minutes, or five breaths guided by a ring; the level can be set for one app alone;\na one-line word after fifteen minutes. Notifications can be delivered together at a few\ntimes of the day (calls, alarms and the apps you mark always come at once), with a\nquick-settings tile. The data is Android's own usage\nrecord, read with the \"usage access\" permission; nothing leaves the phone, no network\npermission. Text only, white on black.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"2f8fc0c831fc10087a1b115c1b8082a751e00e852061ea4aae3fdbc60af9dbed": {"added": 1792052606000, "file": {"name": "/ReadersAttention-v1.2.0.apk", "sha256": "2f8fc0c831fc10087a1b115c1b8082a751e00e852061ea4aae3fdbc60af9dbed", "size": 14655850}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 3, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "com.freedomfighter.readersattention.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersaudio": {"metadata": {"lastUpdated": 1791717520000}, "versions": {"08184e87e4a926cf0a7d1b26acc03361cddeb1743b5270a08151f73fc3b3bd5a": null, "a418a4991e368b1ec2b23d980f24683da370c2a31dc8861e67a33bae34dfe0da": {"added": 1791717520000, "file": {"name": "/ReadersAudio-v1.7.0.apk", "sha256": "a418a4991e368b1ec2b23d980f24683da370c2a31dc8861e67a33bae34dfe0da", "size": 51284442}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "1.7.0", "versionCode": 15, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.freedomfighter.readersaudio.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersbooks": {"metadata": {"lastUpdated": 1791961892000}, "versions": {"a6650294dc551cb01193a2d869c28ba79bc5977af66f040ec410350362b7d322": null, "d2146eae329a1d1eff0e3531f7ce69c15395c46779fcc1ed70f52ac22ea4a8c2": {"added": 1791961892000, "file": {"name": "/ReadersBooks-v1.9.0.apk", "sha256": "d2146eae329a1d1eff0e3531f7ce69c15395c46779fcc1ed70f52ac22ea4a8c2", "size": 6189821}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v