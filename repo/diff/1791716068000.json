sion.ACCESS"}, {"name": "com.freedomfighter.readersnotes.permission.ACCESS"}, {"name": "com.freedomfighter.readersmindful.permission.ACCESS"}, {"name": "com.freedomfighter.readersrecorder.permission.ACCESS"}, {"name": "com.freedomfighter.readerslauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersnight": {"metadata": {"lastUpdated": 1792052606000, "description": {"en-US": "One switch turns the screen gray, as warm as the phone allows, and dim: Android's own\ncolour correction, Night Light and extra dim driven together, and put back as they were\nwhen you switch off. The switch lives in the quick settings, in a home-screen widget and\nin the app; a schedule can turn it on at a time or at sunset and off in the morning. The\nfull filter needs a permission given once from a computer (one adb command, shown in the\napp); no root. Without it, the app lays a warm, dimmed veil over the apps instead, without\ngrayscale. Android does not let an app remove blue entirely, so the tint stops at the\nphone's warmest setting. No network permission, no account, nothing collected.\n"}}, "versions": {"a0ac53182661c50aacb40eac82eb6f9674f3665298896c48bff0d8f168e29093": null, "d126af73940df75f31990d929c3e7f29deaebac6603e942f942a7dcd9d0cdf11": {"added": 1792052606000, "file": {"name": "/ReadersNight-v1.3.0.apk", "sha256": "d126af73940df75f31990d929c3e7f29deaebac6603e942f942a7dcd9d0cdf11", "size": 14520738}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.3.0", "versionCode": 4, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.WRITE_SECURE_SETTINGS"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.USE_EXACT_ALARM"}, {"name"