 any podcast app reads, and the settings — with the place\neach episode was left — as a JSON file. Those two files are the whole of the synchronisation\nwith the desktop twin: there is no server and no account, and nothing leaves the phone but the\nrequests to the feeds themselves.\n\nEnglish, French, German, Spanish, Portuguese and Russian; white on black or black on white,\nthree fonts, three text sizes.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"78c9e4a0ff0a67214817dffaf1b1ff30767e85596465cb16cab5abec63eb7de1": {"added": 1789734674000, "file": {"name": "/ReadersPodcasts-v0.1.0.apk", "sha256": "78c9e4a0ff0a67214817dffaf1b1ff30767e85596465cb16cab5abec63eb7de1", "size": 20637419}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerspodcasts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersrecorder": {"metadata": {"lastUpdated": 1789651044000}, "versions": {"37df51cb199100ce5a7af1045f6531a7d6fa445c8cb1eb288b11882b47bfac92": null, "c8fa7fccf9d5b9dc7ce332d0870169c49b14ad242d291bfdc1412de57281e182": {"added": 1789651044000, "file": {"name": "/ReadersRecorder-v1.9.0.apk", "sha256": "c8fa7fccf9d5b9dc7ce332d0870169c49b14ad242d291bfdc1412de57281e182", "size": 23819276}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a"