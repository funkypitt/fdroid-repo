{"repo": {"timestamp": 1785137802000}, "packages": {"com.freedomfighter.retreatplayer": {"metadata": {"lastUpdated": 1785137802000}, "versions": {"328ee0ca69f9a2f0186e49bbf0dccb387b675d3808fc726914f9edac913353f5": {"added": 1785137802000, "file": {"name": "/RetreatPlayer-v1.3.0.apk", "sha256": "328ee0ca69f9a2f0186e49bbf0dccb387b675d3808fc726914f9edac913353f5", "size": 16405046}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.3.0", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.retreattimer": {"metadata": {"lastUpdated": 1785137344000, "description": {"en-US": "Retreat Timer rings a recording of three singing-bowl bells at the times of day\nyou choose — the signal to begin or end a sitting — so a meditation retreat\nkeeps running on schedule even when the teacher is not present.\n\nBuilt for one job: the bells ring no matter what.\n\n* Exact alarms via the same mechanism the stock Clock app uses, so they fire on\n  time even when the device is locked, asleep, or in Doze for hours.\n* A foreground service holds a wake lock and plays through the alarm stream, so\n  the system cannot mute or kill the bells mid-ring.\n* Alarms are re-armed automatically after a reboot, time change, or app update.\n* A readiness light turns green once battery optimisation and notifications are\n  set, so the teacher can leave knowing the schedule is safe.\n\nEasy to set up:\n\n* Tap Add bell and pick the time. The picker opens ready for typing, so any\n  minute is set directly — 06:47, not just 06:45 — with a dial one tap away.\n* Tap any time to edit it; toggle bells on or off; delete with one tap.\n* Four bell sounds to choose from — singing bell, Tibetan E flat bowl, gong\n  bowl and Satipanya — all matched to the same loudness, so switching changes\n  the timbre and never the volume.\n* Bell volume and talk volume are set separately, because a spoken recording\n  normally has to be much louder than a bowl strike to fill the same room.\n  Each has its own Test button that plays at the exact level the room will\n  hear, and Test talk uses the talk that is actually coming up next.\n\nDharma talk library:\n\n* Add talks from this phone, an Infomaniak kDrive public share link, or a\n  podcast RSS feed — every import is downloaded into the app so playback works\n  with no network at all.\n* Play a talk instantly, or schedule one to play at a set time exactly like a\n  bell.\n* A player bar with a draggable progress bar — talks often open with minutes\n  of silence, so drag straight to the speech instead of waiting it out.\n  Restart, 10 seconds back and forward, pause, and both elapsed and remaining\n  time, from the app or the notification.\n* Optional \"keep Bluetooth speaker awake\": portable speakers disconnect after\n  a few minutes of silence, so the next bell would come faintly from the\n  tablet. Turn it on when using an external speaker and it plays a\n  barely-audible sound between bells to hold the link open. The bells are\n  untouched — still the exact-alarm system, this is only a separate faint\n  stream.\n\nNo ads, no tracking, no accounts. The schedule repeats every day.\n"}}, "versions": {"6edb4e4a21c56818392351aef41c5b5bf2ff946e9878aef353ad3dab32f1de5b": {"added": 1785137344000, "file": {"name": "/RetreatTimer-v1.8.4.apk", "sha256": "6edb4e4a21c56818392351aef41c5b5bf2ff946e9878aef353ad3dab32f1de5b", "size": 21475627}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.8.4", "versionCode": 14, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.USE_EXACT_ALARM"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.freedomfighter.retreattimer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "b8fbc51132e66ad4b33aed2ef33b8b45f9c200a78e68dd1648da541588788e66": {"added": 1784897116000, "file": {"name": "/RetreatTimer-v1.8.3.apk", "sha256": "b8fbc51132e66ad4b33aed2ef33b8b45f9c200a78e68dd1648da541588788e66", "size": 21319246}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.8.3", "versionCode": 13, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.USE_EXACT_ALARM"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_ST