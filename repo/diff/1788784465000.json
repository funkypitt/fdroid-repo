{"repo": {"timestamp": 1788811423000}, "packages": {"com.freedomfighter.readerscalendar": {"metadata": {"added": 1788809892000, "categories": ["Time"], "lastUpdated": 1788811422000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-calendar", "authorName": "funkypitt", "name": {"en-US": "Reader's Calendar"}, "summary": {"en-US": "Black-and-white, text-only calendar"}, "description": {"en-US": "Reader's Calendar shows the phone's own calendars — the ones your accounts already\nsync (Google, Infomaniak, Nextcloud…) — as plain text, white on black or black on\nwhite. No colour codes: the calendar an event belongs to is named in a quiet line of\ntext on the event's page.\n\n* Agenda: the coming days as a list. Month: a grid of numbers, a dot for days with\n  events, today inverted. Week: a list in portrait, a time grid in landscape.\n* Event page with location and description; create and edit events with reminder,\n  repetition, all-day, calendar choice.\n* Landscape puts the month grid beside the agenda and splits event pages in two.\n* Can be the default calendar app, including for Reader's Launcher's agenda tile.\n\nSerif, sans or monospace; three text sizes. No account, no network of its own.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"d09a0c2b42a2116cd987bbb7242be32c0a940a934f2a84589f0087880dbe4062": {"added": 1788811422000, "file": {"name": "/ReadersCalendar-v1.2.0.apk", "sha256": "d09a0c2b42a2116cd987bbb7242be32c0a940a934f2a84589f0087880dbe4062", "size": 8125657}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 3, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name"