{"repo": {"timestamp": 1791631424000}, "packages": {"com.freedomfighter.readersbooks": {"metadata": {"lastUpdated": 1791631422000, "description": {"en-US": "A shelf as a plain list; books as pages of text cut at whole lines, turned by a tap\n— made for e-ink. EPUB, MOBI, FB2, TXT; the place in each book is kept. No store, no\naccount; the network is used only for the optional library on your own drive (WebDAV),\nlisted by folder, a book downloaded when tapped. Highlights, comments and the page you\nare at are kept next to each book of the library and follow it to your other devices.\n"}}, "versions": {"3b9828fb66aebdce478d471ca73b1878132ec4150a91690a621676d873fdbc04": null, "23131497ef2314252e49021a78f0b414e36ed3793050ed5f4b076565c7f09bb9": {"added": 1791631422000, "file": {"name": "/ReadersBooks-v1.7.1.apk", "sha256": "23131497ef2314252e49021a78f0b414e36ed3793050ed5f4b076565c7f09bb9", "size": 6157053}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.7.1", "versionCode": 15, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "com.freedomfighter.readersbooks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersnotes": {"metadata": {"lastUpdated": 1791624640000}, "versions": {"990e0f03091d5eeb5ddbc8cb30e1cbe74ab1146223c21face6393499d3dca11d": null, "d153e5c08d981053ad0f956eb3586086583ae80f24194c994fe70d4b07626477": {"added": 1791624640000, "file": {"name": "/ReadersNotes-v1.8.0.apk", "sha256": "d153e5c08d981053ad0f956eb3586086583ae80f24194c994fe70d4b07626477", "size": 13223033}, "manifest": {"nati