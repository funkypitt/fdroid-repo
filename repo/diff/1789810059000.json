pitt/readers-foodlog", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersfoodlog/en-US/featureGraphic_nH-EnhD8nMPza7Dh8WAfKwbQ5ImghAhLWIUwsoei4iE=.png", "sha256": "9c7f849e10fc9cc3f36bb0e1f1601f2b06d0e489a084084b588530b287a2e221", "size": 24578}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Food Log"}, "summary": {"en-US": "A food journal made of photos"}, "description": {"en-US": "Photograph what you are about to eat, as thoughtlessly as you would reach\ninto a bowl of peanuts. The widget, the quick-settings tile or the app's\nbig button open the viewfinder; a touch anywhere (or a volume key) takes\nthe photo and the screen closes by itself. Each photo is labelled\nbreakfast, lunch, dinner or snack from the time it was taken. The home\nscreen is one folder per day. Physical activity in one tap: strength\ntraining, intense activity, endurance, or a line of your own. Your weight\nonce a day, with a curve of how it moves. Everything\nstays on the phone: no network permission, no account. Export the journal\nas one zip to carry it to a new phone; importing adds and replaces\nnothing. Black and white, text only, six languages.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersfoodlog/en-US/icon_ES1G_rDdDJhVKusRTlI6aCBObrNM3sGbUjPQcYLpUGI=.png", "sha256": "112d46feb0dd0c98552aeb114e523a68204e6eb34cdec19b5233d07182e95062", "size": 11217}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"07e503e7b1b6cde13074f753d5a284cc62a697b3abd7190f3ae6724802b5a76b": {"added": 1789859493000, "file": {"name": "/ReadersFoodLog-v1.2.0.apk", "sha256": "07e503e7b1b6cde13074f753d5a284cc62a697b3abd7190f3ae6724802b5a76b", "size": 6938606}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 3, "features": [{"name": "android.hardware.camera.any"}], "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 