er.permission.ACCESS"}, {"name": "com.freedomfighter.readerslauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersnight": {"metadata": {"added": 1790847552000, "categories": ["System"], "issueTracker": "https://github.com/funkypitt/readers-night/issues", "lastUpdated": 1790847552000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-night", "webSite": "https://github.com/funkypitt/readers-night", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersnight/en-US/featureGraphic_RguqcgTYvniFrCGwSvCWrG4EYm9mR8u8vJXrBsRNc2E=.png", "sha256": "460baa7204d8be7885ac21b04af096ac6e04626f6647cbbcbc95eb06c44d7361", "size": 25833}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Night Filter"}, "summary": {"en-US": "Grayscale, warm and dim screen in one tap, from the quick settings"}, "description": {"en-US": "One switch turns the screen gray, as warm as the phone allows, and dim: Android's own\ncolour correction, Night Light and extra dim driven together, and put back as they were\nwhen you switch off. The switch lives in the quick settings, in a home-screen widget and\nin the app. It needs a permission given once from a computer (one adb command, shown in\nthe app); no root. Android does not let an app remove blue entirely, so the tint stops\nat the phone's warmest setting. No network permission, no account, nothing collected.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersnight/en-US/icon_12sp55VSp58dzfmDrBfnoSla8EaaeHuZyA1z-QMZIHU=.png", "sha256": "d76b29e79552a79f1dcdf983ac17e7a1295af0469a787b99c80d73f903192075", "size": 7810}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"066d497139f7d724101b2d379ed1863abb9ea61207f375c88a21017bd75ec6c6": {"added": 1790847552000, "file": {"name": "/ReadersNight-v1.0.0.apk", "sha256": "066d497139f7d724101b2d379ed1863abb9ea61207f375c88a21017bd75ec6c6", "size": 14451106}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.WRITE_SECURE_SETTINGS"}, {"name": "com.freedomfighter.readersnight.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerspodcasts": {"metadata": {"lastUpdated": 1790534877000}, "versions": {"5c8ccdeedcaf58389c0ecff7dfcb14bc5906ae2d5736fd8c8a81d702aab1186a": null, "1c103d2dbf9af22eefa36024ddddefed5735bce3422f75cf684b2f3de49a4ab4": {"added": 1790534877000, "file": {"name": "/ReadersPodcasts-v1.1.2.apk", "sha256": "1c103d2dbf9af22eefa36024ddddefed5735bce3422f75cf684b2f3de49a4ab4", "size": 31615390}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.2", "versionCode": 18, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerspodcasts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersscanner": {"metadata": {"lastUpdated": 1790538343000, "description": {"en-US": "Photographs documents, one page or many: the page is found, straightened and cleaned, a\nblurred shot is flagged at once, and the text is read on the phone in seven languages.\nEach document becomes a searchable PDF, dated and named by you, filed in\nplain folders, shareable as PDF, pictures or text, and copied to your own WebDAV folder\n(kDrive, Nextcloud) if you like.\n\nAt first start you choose the engine: Google ML Kit (most reliable; closed code, needs\nGoogle Play services, sends usage statistics to Google, never your documents) or the free\nones (the app's own page finder and Tesseract). Black and white, text only.\n"}}, "versions": {"3a2fb419167eb0585d400b9744f1763b24237bf184004f1ee795b652fb8d967f": null, "82e4f9e0b68c351d2381d1041fcc622453297899299cf124f48ade02a5579960": {"added": 1790538343000, "file": {"name": "/ReadersScanner-v1.1.2.apk", "sha256": "82e4f9e0b68c351d2381d1041fcc622453297899299cf124f48ade02a5579960", "size": 40726724}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a"], "versionName": "1.1.2", "versionCode": 7, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.CAMERA"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readersscanner.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}, "antiFeatures": {"NonFreeDep": {"en-US": "If chosen at first start, Google ML Kit's document scanner runs through Google Play services."}, "Tracking": {"en-US": "Only with ML Kit chosen, Google's library sends usage statistics to Google (never the documents). The free engines send nothing."}, "UpstreamNonFree": {"en-US": "The app includes Google ML Kit (closed code), next to the free engines (Tesseract and its own page finder)."}}}}}, "com.freedomfighter.tchitchi": {"metadata": {"added": 1790858446000, "categories": ["System"], "lastUpdated": 1790863591000, "license": "MIT", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.tchitchi/en-US/featureGraphic_8Yg_RW6vBHml72aDY6I_2bi_qBHXit8FjmfGhDUuBUA=.png", "sha256": "f1883f456eaf0479a5ef668363a23fd9b8bfa811d78adf058e67c684352e0540", "size": 19797}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Tchitchi"}, "summary": {"en-US": "A large, calm home screen for older people, safe from accidental changes"}, "description": {"en-US": "A Windows Phone 7-style launcher: two columns of big square tiles that scroll, and a\ntile showing new messages with who wrote. The home screen cannot be changed by mistake:\na long press counts only after eight seconds, then three questions must each be answered\nyes; the list of all apps asks once before it opens. Twelve themes, among them Unity,\nwith each app's own icon on a tile of its colour. Messages are read from the\nnotifications, kept in memory only; no ads, no tracking.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.tchitchi/en-US/icon_k4-grwcmphnp1dEFBk08iXEwN0O3dc6X8NvZ1qp8x10=.png", "sha256": "938fa0af0726a619e9d5d105064d3c8971303743b775ce97f0dbd9d6aa7cc75d", "size": 1291}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"8069a4ec1762686313eaf46cae21b57617b6bcf6ed20b6872d94263af7c76c24": {"added": 1790863591000, "file": {"name": "/Tchitchi-v0.2.3.apk", "sha256": "8069a4ec1762686313eaf46cae21b57617b6bcf6ed20b6872d94263af7c76c24", "size": 5948426}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.2.3", "versionCode": 6, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_C