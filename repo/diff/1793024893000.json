{"repo": {"timestamp": 1793202574000, "categories": {"Navigation": {"name": {"en-US": "Navigation"}}}}, "packages": {"com.freedomfighter.swissbikehike": {"metadata": {"added": 1793202572000, "categories": ["Navigation", "Sports & Health"], "lastUpdated": 1793202572000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/swiss-bike-hike-map", "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Swiss Bike-Hike Map"}, "summary": {"en-US": "Bike and hike map of Switzerland, official trails, routing and guidance on the phone"}, "description": {"en-US": "A map for cycling and hiking in Switzerland, in the spirit of the old GPS boxes: one\nscreen, big buttons, the official hiking trails and cycling routes in their signpost\ncolours on the swisstopo map. Routing runs on the phone (BRouter, OpenStreetMap data),\nthrough as many stops as you like, with turn-by-turn guidance that goes on with the\nscreen off, an elevation profile and the time of arrival; a GPX track can be followed as\nit is. Favourites, people and firms from the search.ch directory with your own key, a\nnight map, and the whole country saved offline in one button. Six languages. No account,\nno tracking; the network serves only the map tiles, the routing data and the searches you\nask for.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.swissbikehike/en-US/icon_omE7_-fDl7KVcsyvELY9VB0z9M6hKHJbybvszFZkVRM=.png", "sha256": "a2613bffe7c397b29572ccaf10b63d541d33f4cea128725bc9bbeccc56645513", "size": 1706}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"fa8d8ad19e94a0d683b1c234dc8de381a702bc61796b84639dcdb8706dd34b68": {"added": 1793202572000, "file": {"name": "/SwissBikeHikeMap-v0.5.1.apk", "sha256": "fa8d8ad19e94a0d683b1c234dc8de381a702bc61796b84639dcdb8706dd34b68", "size": 24877269}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.5.1", "versionCode": 7, "features": [{"name": "android.hardware.vulkan.version"}], "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "com.freedomfighter.swissbikehike.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}