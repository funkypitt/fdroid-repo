{"repo": {"timestamp": 1793265145000, "categories": {"Navigation": {"name": {"en-US": "Navigation"}}}}, "packages": {"com.freedomfighter.swissbikehike": {"metadata": {"added": 1793202572000, "categories": ["Navigation", "Sports & Health"], "lastUpdated": 1793265143000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/swiss-bike-hike-map", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.swissbikehike/en-US/featureGraphic_1iyykHMQQEcc9z9PIudisf62CspKXiwzFulljKL5B5U=.png", "sha256": "d62cb290731040471cf73f4f22e762b1feb60aca4a5e2c3316e9658ca2f90795", "size": 25862}}, "screenshots": {"phone": {"en-US": [{"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/1.png", "sha256": "9cd803b7d7fb19af83f82d6dfba54d944d3d480cfcf960c0041cab536111ada9", "size": 83043}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/2.png", "sha256": "2d5e1045bac9c85f78f5036778fdfae89e98487571284b5a5f82da9bb2b7517b", "size": 512299}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/3.png", "sha256": "00175536612f8c3cc10ad1d288047556ca5cf708828020513f4ba41b7ba7420f", "size": 335329}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/4.png", "sha256": "6216924301d02d8836411efd3e0d33d1f982f127df829056b9b74f9651e1a3d3", "size": 416305}]}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Swiss Bikers and Pedestrians Map"}, "summary": {"en-US": "Bike, hike and public-transport map of Switzerland, routing and guidance on the phone"}, "description": {"en-US": "A map for cycling, hiking and public transport in Switzerland, in the spirit of the old\nGPS boxes: one screen, big buttons, the official hiking trails, cycling routes and\npublic-transport lines in their signpost colours on the swisstopo map. Routing runs on\nthe phone (BRouter, OpenStreetMap data), through as many stops as you like, with\nturn-by-turn guidance that goes on with the screen off, an elevation profile and the\ntime of arrival; a GPX track can be followed as it is. Public transport: the next\njourneys to your stop, drawn leg by leg, then guidance in big letters (walk, board, get\noff, change) with real-time timetables online and an optional offline timetable of all\nSwitzerland. Favourites, people and firms from the search.ch directory with your own\nkey, a night map, and the whole country saved offline in one button. Six languages. No\naccount, no tracking.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.swissbikehike/en-US/icon_omE7_-fDl7KVcsyvELY9VB0z9M6hKHJbybvszFZkVRM=.png", "sha256": "a2613bffe7c397b29572ccaf10b63d541d33f4cea128725bc9bbeccc56645513", "size": 1706}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"534c31cdf43bc2d6b488905db2bc702384d8ac5218a0dc3155a8ca8ffab0cac4": {"added": 1793265143000, "file": {"name": "/SwissBikersPedestriansMap-v0.6.3.apk", "sha256": "534c31cdf43bc2d6b488905db2bc702384d8ac5218a0dc3155a8ca8ffab0cac4", "size": 25135485}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.6.3", "versionCode": 11, "features": [{"name": "android.hardware.vulkan.version"}], "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "com.freedomfighter.swissbikehik