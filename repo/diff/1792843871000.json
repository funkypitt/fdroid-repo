{"repo": {"timestamp": 1793260780000, "categories": {"Navigation": {"name": {"en-US": "Navigation"}}}}, "packages": {"com.freedomfighter.boxbreathing": {"metadata": {"lastUpdated": 1792937752000}, "versions": {"1583f32ded154f0eb23eb1a71b5b78813ce170a903281f77cb89fd90bbbaa8f1": null, "ca553db6e494549683d960865e60d5072bed8ec89147018dd35bedea5cb1c9eb": {"added": 1792937752000, "file": {"name": "/box-breathing-v2.1.0.apk", "sha256": "ca553db6e494549683d960865e60d5072bed8ec89147018dd35bedea5cb1c9eb", "size": 27335650}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "2.1.0", "versionCode": 6, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.READ_EXTERNAL_STORAGE"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE"}, {"name": "android.permission.MODIFY_AUDIO_SETTINGS"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.freedomfighter.boxbreathing.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersphone": {"metadata": {"lastUpdated": 1793024891000, "description": {"en-US": "A call rings on the whole screen with the person's photo and name and two big buttons;\nmissed calls stay at the top until answered with \"call back\" or \"OK\". Contacts read\nfavourites, then the people called lately, then everyone; a keypad with large keys; the\nlist of calls. Leave the call for another app and it stays in view: Android's own call\nnotification with one big \"hang up\", and a wide green band that brings the call back.\n\nRecording (off by default): a call is recorded and written out on the phone by\nwhisper.cpp, the model fetched once and shared with the other Reader's apps. Android only\ngives the sound of a call to an accessibility service, so one has to be switched on; the\nsettings say so. Tell the other person — in many countries the law requires it.\n\nUnknown callers (off by default): a number nobody in the contacts has is looked up in\nthe Swiss directory of search.ch, with your own free key for private use pasted in the\nsettings; only that number leaves the phone. Data: Swisscom Directories AG.\n\nSix languages. No account; the network is used only to fetch the model and, when you ask\nfor it, the directory.\n"}}, "versions": {"255aa05a2467aba400ffba88ad462067b7090a2a42e84531031d3c7c782003f4": null, "d068f8585417b94923a0c3dcfc3343afcd031caa6a8620eedb9c5aa7efe00622": {"added": 1793024891000, "file": {"name": "/ReadersPhone-v1.6.0.apk", "sha256": "d068f8585417b94923a0c3dcfc3343afcd031caa6a8620eedb9c5aa7efe00622", "size": 36230845}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "1.6.0", "versionCode": 11, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_PHONE_CALL"}, {"name": "android.permission.MANAGE_OWN_CALLS"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readersphone.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.swissbikehike": {"metadata": {"added": 1793202572000, "categories": ["Navigation", "Sports & Health"], "lastUpdated": 1793260779000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/swiss-bike-hike-map", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.swissbikehike/en-US/featureGraphic_1iyykHMQQEcc9z9PIudisf62CspKXiwzFulljKL5B5U=.png", "sha256": "d62cb290731040471cf73f4f22e762b1feb60aca4a5e2c3316e9658ca2f90795", "size": 25862}}, "screenshots": {"phone": {"en-US": [{"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/1.png", "sha256": "9cd803b7d7fb19af83f82d6dfba54d944d3d480cfcf960c0041cab536111ada9", "size": 83043}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/2.png", "sha256": "2d5e1045bac9c85f78f5036778fdfae89e98487571284b5a5f82da9bb2b7517b", "size": 512299}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/3.png", "sha256": "00175536612f8c3cc10ad1d288047556ca5cf708828020513f4ba41b7ba7420f", "size": 335329}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/4.png", "sha256": "6216924301d02d8836411efd3e0d33d1f982f127df829056b9b74f9651e1a3d3", "size": 416305}]}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Swiss Bikers and Pedestrians Map"}, "summary": {"en-US": "Bike, hike and public-transport map of Switzerland, routing and guidance on the phone"}, "description": {"en-US": "A map for cycling, hiking and public transport in Switzerland, in the spirit of the old\nGPS boxes: one screen, big buttons, the official hiking trails, cycling routes and\npublic-transport lines in their signpost colours on the swisstopo map. Routing runs on\nthe phone (BRouter, OpenStreetMap data), through as many stops as you like, with\nturn-by-turn guidance that goes on with the screen off, an elevation profile and the\ntime of arrival; a GPX track can be followed as it is. Public transport: the next\njourneys to your stop, drawn leg by leg, then guidance in big letters (walk, board, get\noff, change) with real-time timetables online and an optional offline timetable of all\nSwitzerland. Favourites, people and firms from the search.ch directory with your own\nkey, a night map, and the whole country saved offline in one button. Six languages. No\naccount, no tracking.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.swissbikehike/en-US/icon_omE7_-fDl7KVcsyvELY9VB0z9M6hKHJbybvszFZkVRM=.png", "sha256": "a2613bffe7c397b29572ccaf10b63d541d33f4cea128725bc9bbeccc56645513", "size": 1706}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"6892e470107523d5516bb9800079cc824dc307f7eb098922abf501dd8b737f90": {"added": 1793260779000, "file": {"name": "/SwissBikersPedestriansMap-v0.6.1.apk", "sha256": "6892e470107523d5516bb9800079cc824dc307f7eb098922abf501dd8b737f90", "size": 25033029}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.6.1", "versionCode": 9, "features": [{"name": "android.hardware.vulkan.version"}], "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "com.freedomfighter.swissbikehike.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tchitchi": {"metadata": {"lastUpdated": 1793024891000}, "versions": {"33a73b414fe832f38b465828a84b96e0cb6a35d50054dc6c8d0a89197c29c549": null, "442a0d53c0f3f0d4a89e810c89dcf381d0cfc1d9abd8abaf61eadd39600ea6d7": {"added": 1793024891000, "file": {"name": "/Tchitchi-v0.8.0.apk", "sha256": "442a0d53c0f3f0d4a89e810c89dcf381d0cfc1d9abd8abaf61eadd39600ea6d7", "size": 6136898}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.8.0", "versionCode": 20, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerstasks.permission.ACCESS"}, {"name": "com.freedomfighter.readersbooks.permission.ACCESS"}, {"name": "com.freedomfighter.readersnotes.permission.ACCESS"}, {"name": "com.freedomfighter.readersmindful.permission.ACCESS"}, {"name": "com.freedomfighter.readersrecorder.permission.ACCESS"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_PHONE_CALL"}, {"name": "android.permission.MANAGE_OWN_CALLS"}, {"name": "com.freedomfighter.tchitchi.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tchitchi.phone": {"metadata": {"lastUpdated": 1793024891000, "description": {"en-US": "The phone of the Tchitchi launcher as an app of its own, for a phone that keeps its\nlauncher. A call rings on the whole screen with the caller's photo and name in large type\nand two big buttons; missed calls stay at the top until answered with \"call back\" or \"OK\".\nContacts read favourites, then the people called lately, then everyone, with a search\nfield; a keypad with large keys; the list of calls. When another app is opened during a\ncall, a wide green band stays at the top of the screen with the name and the time on the\nline, and a touch brings the call back. Twelve themes. Unknown callers can be looked up\nin the Swiss directory of search.ch with your own free key (off by default; only that\nnumber leaves the phone; data: Swisscom Directories AG). No account, nothing else goes out.\n"}}, "versions": {"85b9d4a17b48d221e1e7d1a0e580e8952f8cf4533fbe0dfafca3f4a4edccb3db": null, "e8e25afb2e9568c2f07f9e011186c7ea65bd826f47979a34917792c4870da61a": {"added": 1793024891000, "file": {"name": "/TchitchiPhone-v1.4.0.apk", "sha256": "e8e25afb2e9568c2f07f9e011186c7ea65bd826f47979a34917792c4870da61a", "size": 6136898}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.4.0", "versionCode": 9, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_PHONE_CALL"}, {"name": "android.permission.MANAGE_OWN_CALLS"}, {"name": "com.freedomfighter.tchitchi.phone.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}