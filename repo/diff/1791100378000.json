{"repo": {"timestamp": 1791212566000, "categories": {"Phone & SMS": {"name": {"en-US": "Phone & SMS"}}}}, "packages": {"com.freedomfighter.readersphone": {"metadata": {"added": 1791212565000, "categories": ["Phone & SMS"], "lastUpdated": 1791212565000, "license": "MIT", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersphone/en-US/featureGraphic_xUXdGKMF_Oo7HseanQU7ZhCwYtYLEPpGRhPtivZiPQM=.png", "sha256": "c545dd18a305fcea3b1ec79a9d053b6610b062d60b10fa464613ed8af6623d03", "size": 24889}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Phone"}, "summary": {"en-US": "A phone in large type, two colours, that can record a call and write it out"}, "description": {"en-US": "A call rings on the whole screen with the person's photo and name and two big buttons;\nmissed calls stay at the top until answered with \"call back\" or \"OK\". Contacts read\nfavourites, then the people called lately, then everyone; a keypad with large keys; the\nlist of calls. Leave the call for another app and it stays in view: Android's own call\nnotification with one big \"hang up\", and a wide green band that brings the call back.\n\nRecording (off by default): a call is recorded and written out on the phone by\nwhisper.cpp, the model fetched once and shared with the other Reader's apps. Android only\ngives the sound of a call to an accessibility service, so one has to be switched on; the\nsettings say so. Tell the other person — in many countries the law requires it.\n\nSix languages. No account; the network is used only to fetch the model.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersphone/en-US/icon_Y9JU0_KVDzdiHH9dd1fv2tnocRUWvD-uJ0x_Wm2PkLA=.png", "sha256": "63d254d3f2950f37621c7f5d7757efdad9e8711516bc3fae274c7f5a6d8f90b0", "size": 4196}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"25b82a979712ebb3d9c7e526b9f0c60f0385deef9ee09520577bb4d71e1ba85e": {"added": 1791212565000, "file": {"name": "/ReadersPhone-v1.0.0.apk", "sha256": "25b82a979712ebb3d9c7e526b9f0c60f0385deef9ee09520577bb4d71e1ba85e", "size": 30615229}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readersphone.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tchitchi": {"metadata": {"lastUpdated": 1791108280000}, "versions": {"578e77eb80e37436aff5efe3fff30191d4d2501bc37eb234b224f3d92c99b641": null, "62ac510154ce1a1a59afe599c473942ac0401d1effe35ed7bf8a5d84511eb45e": {"added": 1791108280000, "file": {"name": "/Tchitchi-v0.4.2.apk", "sha256": "62ac510154ce1a1a59afe599c473942ac0401d1effe35ed7bf8a5d84511eb45e", "size": 6071362}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.4.2", "versionCode": 12, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerstasks.permission.ACCESS"}, {"name": "com.freedomfighter.readersbooks.permission.ACCESS"}, {"name": "com.freedomfighter.readersnotes.permission.ACCESS"}, {"name": "com.freedomfighter.readersmindful.permission.ACCESS"}, {"name": "com.freedomfighter.readersrecorder.permission.ACCESS"}, {"name": "com.freedomfighter.tchitchi.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tchitchi.phone": {"metadata": {"added": 1791114404000, "categories": ["Phone & SMS"], "lastUpdated": 1791211202000, "license": "MIT", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.tchitchi.phone/en-US/featureGraphic_K2F85D6yYZmjyMOw8Qcci4jYoxTOoekY1hNqYzM5nJI=.png", "sha256": "2b617ce43eb26199a3c8c3b0f1071c8b88d8a314cea1e918d6136a6333399c92", "size": 20268}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Tchitchi Phone"}, "summary": {"en-US": "A phone app in large type for older people, calm and without surprises"}, "description": {"en-US": "The phone of the Tchitchi launcher as an app of its own, for a phone that keeps its\nlauncher. A call rings on the whole screen with the caller's photo and name in large type\nand two big buttons; missed calls stay at the top until answered with \"call back\" or \"OK\".\nContacts read favourites, then the people called lately, then everyone, with a search\nfield; a keypad with large keys; the list of calls. When another app is opened during a\ncall, a wide green band stays at the top of the screen with the name and the time on the\nline, and a touch brings the call back. Twelve themes. No account, no network,\nnothing leaves the phone.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.tchitchi.phone/en-US/icon_k9DGhUGa3G_pX1NuVJFiLl3oNUazAarlWOPLnJVW5ws=.png", "sha256": "93d0c685419adc6fe95f536e5491622e5de83546b301aae558e3cb9c9556e70b", "size": 3689}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"26818416e98d8898d7653b5d9a76bd96ccb4201b55c8d4ce2f63615b70c4a499": {"added": 1791211202000, "file": {"name": "/TchitchiPhone-v1.1.0.apk", "sha256": "26818416e98d8898d7653b5d9a76bd96ccb4201b55c8d4ce2f63615b70c4a499", "size": 6087746}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "com.freedomfighter.tchitchi.phone.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}