, "sourceCode": "https://github.com/funkypitt/sobre", "webSite": "https://github.com/funkypitt/sobre", "authorName": "funkypitt", "name": {"en-US": "Sobre"}, "summary": {"en-US": "Audio-only YouTube subscription player, 100% text"}, "description": {"en-US": "Sobre is an anti-brainrot audio player for YouTube subscriptions.\nIt plays only the audio from channels you explicitly follow —\nno video, no thumbnails, no algorithmic recommendations, no Shorts,\nno comments, no infinite scroll.\n\nThe interface is 100% text: no images, no icons, no avatars.\nSubscribe by pasting a channel or video URL, or by sharing directly\nfrom the YouTube app.\n\nFeatures:\n* Audio-only playback with background and lock screen support\n* Subscribe to channels via URL paste or Android share intent\n* Chronological feed — no algorithm, no recommendations\n* Episode chapters and full descriptions\n* Adjustable playback speed (0.75x to 2x)\n* Download episodes for offline listening\n* Periodic RSS-based feed refresh\n* High-contrast text UI, e-ink friendly\n* Fully local, no accounts, no tracking\n\nBuilt with NewPipeExtractor (GPLv3). Not affiliated with YouTube.\n"}, "icon": {"en-US": {"name": "/app.sobre.player/en-US/icon_ew3SUl5du8UtzHC9f30NkVRIyRN0nqt_gzW6-1fUE14=.png", "sha256": "7b0dd2525e5dbbc52dcc70bd7f7d0d915448c913749eab7f8335bafb57d4135e", "size": 4460}}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"b4a213f3642063394c1483df4d1b6001253eb02c89ff533d66282ff44e159af3": {"added": 1780233268000, "file": {"name": "/Sobre-v0.1.0.apk", "sha256": "b4a213f3642063394c1483df4d1b6001253eb02c89ff533d66282ff44e159af3", "size": 11549279}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "app.sobre.player.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.baristatimer": {"metadata": {"added": 1781014819000, "categories": ["System"], "lastUpdated": 1781171027000, "license": "MIT", "authorName": "funkypitt", "name": {"en-US": "Timer for 9Barista"}, "summary": {"en-US": "Unofficial espresso timer for the 9Barista stovetop machine. 3 taps only."}, "description": {"en-US": "A minimal espresso timer designed for the 9Barista double-boiler stovetop\nespresso machine. Unofficial and fan-made — not affiliated with or endorsed\nby 9Barista Ltd.\n\nThree taps per brew:\n1. Tap to start heating (counts up, warns at 8 minutes)\n2. Tap when espresso appears — starts extraction timer with circular\n   progress ring, turns green in the 25–30 second target zone\n3. Tap when done — shows results and grind adjustment advice\n\nHaptic feedback at 25s (target zone), 30s (over target), and 8 min\n(max heating). Screen stays on during brewing.\n\nTimings based on official 9Barista recommendations:\n• Heating: 3–6 minutes typical\n• Extraction: 25–30 seconds\n• Target output: 35–40g\n\nNo ads. No tracking. No accounts. No permissions beyond vibration.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"ec648a24e52a38930eada0a362a296f2cc1255189538164c974ad7c5adeeb5f5": {"added": 1781171027000, "file": {"name": "/TimerFor9Barista-v1.1.1.apk", "sha256": "ec648a24e52a38930eada0a362a296f2cc1255189538164c974ad7c5adeeb5f5", "size": 957022}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.1", "versionCode": 3, "usesSdk": {"m