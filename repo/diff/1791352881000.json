{"repo": {"timestamp": 1791624642000}, "packages": {"com.freedomfighter.readersbooks": {"metadata": {"lastUpdated": 1791624640000, "description": {"en-US": "A shelf as a plain list; books as pages of text cut at whole lines, turned by a tap\n— made for e-ink. EPUB, MOBI, FB2, TXT; the place in each book is kept. No store, no\naccount; the network is used only for the optional library on your own drive (WebDAV),\nlisted by folder, a book downloaded when tapped. Highlights, comments and the page you\nare at are kept next to each book of the library and follow it to your other devices.\n"}}, "versions": {"cf09c9e651a21f558f695e50b1d1c42b375843dddee2dc8389de565719f28d33": null, "28c53d2eef3f285b03a213df69709b971bedfd740ddd702515a8505cc55e0797": {"added": 1791624640000, "file": {"name": "/ReadersBooks-v1.7.0.apk", "sha256": "28c53d2eef3f285b03a213df69709b971bedfd740ddd702515a8505cc55e0797", "size": 6140669}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.7.0", "versionCode": 14, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "com.freedomfighter.readersbooks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersnotes": {"metadata": {"lastUpdated": 1791624640000}, "versions": {"990e0f03091d5eeb5ddbc8cb30e1cbe74ab1146223c21face6393499d3dca11d": null, "d153e5c08d981053ad0f956eb3586086583ae80f24194c994fe70d4b07626477": {"added": 1791624640000, "file": {"name": "/ReadersNotes-v1.8.0.apk", "sha256": "d153e5c08d981053ad0f956eb3586086583ae80f24194c994fe70d4b07626477", "size": 13223033}, "manifest": {"nati