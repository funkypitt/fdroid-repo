{"repo": {"timestamp": 1790861046000}, "packages": {"com.freedomfighter.readersfiles": {"metadata": {"added": 1790861044000, "categories": ["System"], "issueTracker": "https://github.com/funkypitt/readers-files/issues", "lastUpdated": 1790861044000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/funkypitt/readers-files", "webSite": "https://github.com/funkypitt/readers-files", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersfiles/en-US/featureGraphic_O0ilAZyV1UczK0mJdFm1OYU8j-wVaL5rzQCHI-SVVxI=.png", "sha256": "3b48a5019c95d547332b49897459b539853c8fec1568be6bcd008723e4955712", "size": 23437}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Files"}, "summary": {"en-US": "A file manager that opens on a page of plain words, black and white"}, "description": {"en-US": "It opens on a list, not a grid of cards: Downloads, Videos, Images, Audio, Documents,\nApps, Archives, then the phone's storage and its root with the space left. ZIP files\nare browsed in place; 7z, rar, tar and their compressed forms are unpacked beside the\narchive. Viewers for pictures, video, audio, PDF and text are built in. A modified\nversion of Prism File Explorer (GPL-3.0). No network permission, nothing collected.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersfiles/en-US/icon_NVKVyCqAWUk3xYkQHZQIiTE73rpJehG0tOtMyWpVzSY=.png", "sha256": "355295c82a80594937c589101d940889313bdeba497a11b4b4eb4cc96a55cd26", "size": 1652}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"3e5574614997c6713f22986fec0bf1103f8bc9a3ddb6b1930f00012a479d7a72": {"added": 1790861044000, "file": {"name": "/ReadersFiles-v1.0.0.apk", "sha256": "3e5574614997c6713f22986fec0bf1103f8bc9a3ddb6b1930f00012a479d7a72", "size": 19074507}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.READ_EXTERNAL_STORAGE"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE"}, {"name": "android.permission.MANAGE_EXTERNAL_STORAGE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.REQUEST_INSTALL_PACKAGES"}, {"name": "com.android.launcher.permission.INSTALL_SHORTCUT"}, {"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "com.freedomfighter.readersfiles.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tchitchi": {"metadata": {"added": 1790858446000, "categories": ["System"], "lastUpdated": 1790858446000, "license": "MIT", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.tchitchi/en-US/featureGraphic_8Yg_RW6vBHml72aDY6I_2bi_qBHXit8FjmfGhDUuBUA=.png", "sha256": "f1883f456eaf0479a5ef668363a23fd9b8bfa811d78adf058e67c684352e0540", "size": 19797}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Tchitchi"}, "summary": {"en-US": "A large, calm home screen for older people, safe from accidental changes"}, "description": {"en-US": "A Windows Phone 7-style launcher: two columns of big square tiles that scroll, and a\ntile showing new messages with who wrote. The home screen cannot be changed by mistake:\na long press counts only after eight seconds, then three questions must each be answered\nyes; the list of all apps asks once before it opens. Twelve themes, among them Unity,\nwith each app's own icon on a tile of its colour. Messages are read from the\nnotifications, kept in memory only; no ads, no tracking.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.tchitchi/en-US/icon_k4-grwcmphnp1dEFBk08iXEwN0O3dc6X8NvZ1qp8x10=.png", "sha256": "938fa0af0726a619e9d5d105064d3c8971303743b775ce97f0