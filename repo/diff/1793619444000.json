ission": [{"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readersnotes.permission.ACCESS"}, {"name": "com.freedomfighter.readersrecorder.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.swissbikehike": {"metadata": {"lastUpdated": 1793713994000, "description": {"en-US": "A map for cycling, hiking and public transport in Switzerland, in the spirit of the old\nGPS boxes: one screen, big buttons, the official hiking trails, cycling routes and\npublic-transport lines in their signpost colours on the swisstopo map. Routing runs on\nthe phone (BRouter, OpenStreetMap data), through as many stops as you like, with\nturn-by-turn guidance that goes on with the screen off, an elevation profile and the\ntime of arrival; a GPX track can be followed as it is. Public transport: the next\njourneys to your stop, drawn leg by leg, then guidance in big letters (walk, board, get\noff, change) with real-time timetables online and an optional offline timetable of all\nSwitzerland. What is around you, offline: drinking water, shelters, huts, fire places,\nbike shops, bakeries, cafés, restaurants, shops, campsites… from OpenStreetMap, searched by\ncategory or name, shown on the map, each with its card (open now, hours, phone, add to\ncontacts). Favourites, people and firms from the\nsearch.ch directory with your own key, which also completes a place with its phone and\naddress; a night map, and the whole country saved offline in one button. A route planner\non every map (start, destination, date and time, share, keep, GO). Six languages. No\naccount, no tracking: the network serves the map tiles, the downloads and searches you\nask for, and the transit map sends your position to transport.opendata.ch to find the\nstops around you.\n"}}, "versions": {"a5c56db5b731e81b11823178900bb9463edc436c863ddb75dc4ace5a8286c817": null, "8d0000039b59ad30e5ca7b49b862b4b601525cc6ac8d3eaf4be7bfbc612c43f2": {"added": 1793713994000, "file": {"name": "/SwissBikersPedestriansMap-v0.9.1.apk", "sha256": "8d0000039b59ad30e5ca7b49b862b4b601525cc6ac8d3eaf4be7bfbc612c43f2", "size": 25323957}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.9.1", "versionCode": 19, "features": [{"name": "android.hardware.vulkan.version"}], "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "com.freedomfighter.swissbikehike.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.local2p.games": {"metadata": {"lastUpdated": 1793712046000}, "versions": {"1e3d20cf6609c805014c6a0879088ffe31ea1c4f821af6a8c7cf828ae10fd9e6": null, "e6218b84cbf1f5fd3ce14113972ea8d724f7b3c3f125cb4d2b7124807fc43219": {"added": 1793712046000, "file": {"name": "/2P-Games-v1.45.apk", "sha256": "e6218b84cbf1f5fd3ce14113972ea8d724f7b3c3f125cb4d2b7124807fc43219", "size": 6193987}, "manifest": {"versionName": "1.45", "versionCode": 48, "usesSdk