{"repo": {"timestamp": 1789025759000, "categories": {"Writing": {"name": {"en-US": "Writing"}}}}, "packages": {"ch.littre.littre_app": {"metadata": {"lastUpdated": 1788777223000, "description": {"en-US": "Le dictionnaire de la langue fran\\xE7aise d'\\xC9mile Littr\\xE9,\ncomplet et enti\\xE8rement gratuit, consultable hors-ligne.\n\nWidget d'\\xE9cran d'accueil \\xAB Mot du jour \\xBB, et mot du jour expos\\xE9 aux\nautres applications (tuile de Reader's Launcher).\n78 599 entr\\xE9es avec d\\xE9finitions, \\xE9tymologies et citations.\nRecherche instantan\\xE9e, mot du jour, favoris, renvois crois\\xE9s\ncliquables, mode sombre. Aucune connexion internet requise.\nDonn\\xE9es lexicographiques sous licence CC BY-SA 3.0\n(Fran\\xE7ois Gannaz, littre.org).\n"}}, "versions": {"324eccd9fad3fe51e413b94e835aade7eb0912ceaba77e7aa4aebf731e9fbc7f": {"added": 1788777223000, "file": {"name": "/Littre-v1.1.0-arm64.apk", "sha256": "324eccd9fad3fe51e413b94e835aade7eb0912ceaba77e7aa4aebf731e9fbc7f", "size": 83741884}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.1.0", "versionCode": 2002, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "ch.littre.littre_app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.baristatimer": {"metadata": {"added": 1781170429000}, "versions": {"4f4933d57384be9a668f18ebb3fccb034f0387cc8ae8c75dea865130fa189d7c": null}}, "com.freedomfighter.readersbooks": {"metadata": {"added": 1788959955000, "categories": ["Reading"], "issueTracker": "https://github.com/funkypitt/readers-books/issues", "lastUpdated": 1788959955000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-books", "webSite": "https://github.com/funkypitt/readers-books", "authorName": "funkypitt", "name": {"en-US": "Reader's Books"}, "summary": {"en-US": "Black-and-white e-book reader with a shelf"}, "description": {"en-US": "A shelf of books as a plain list, and pages of plain text cut at whole\nlines. EPUB, MOBI, FB2 and text files, opened from the app, a file manager\nor a share. Tap halves to turn pages, long press for chapters and text\nsize. Position remembered per book. White on black or black on white.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"1321e4484c71d837d4cd3aa175ad5b8aa5dc529e839931bd7cfc90d768aea2dc": {"added": 1788959955000, "file": {"name": "/ReadersBooks-v1.1.1.apk", "sha256": "1321e4484c71d837d4cd3aa175ad5b8aa5dc529e839931bd7cfc90d768aea2dc", "size": 8046629}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.1", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readersbooks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerscalendar": {"metadata": {"added": 1788809892000, "categories": ["Time"], "lastUpdated": 1788961743000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-calendar", "authorName": "funkypitt", "name": {"en-US": "Reader's Calendar"}, "summary": {"en-US": "Black-and-white, text-only calendar"}, "description": {"en-US": "Reader's Calendar shows the phone's own calendars — the ones your accounts already\nsync (Google, Infomaniak, Nextcloud…) — as plain text, white on black or black on\nwhite. No colour codes: the calendar an event belongs to is named in a quiet line of\ntext on the event's page.\n\n* Agenda: the coming days as a list. Month: a grid of numbers, a dot for days with\n  events, today inverted. Week: a list in portrait, a time grid in landscape.\n* Event page with location and description; create and edit events with reminder,\n  repetition, all-day, calendar choice.\n* Landscape puts the month grid beside the agenda and splits event pages in two.\n* Can be the default calendar app, including for Reader's Launcher's agenda tile.\n\nSerif, sans or monospace; three text sizes. No account, no network of its own.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"be2dcdf70e0aa34a1ae310ddf03b69491dd4e272b2c1b14b59481a7b87e56d2c": {"added": 1788961743000, "file": {"name": "/ReadersCalendar-v1.7.1.apk", "sha256": "be2dcdf70e0aa34a1ae310ddf03b69491dd4e272b2c1b14b59481a7b87e56d2c", "size": 8156429}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.7.1", "versionCode": 11, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerscalendar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "44305395b83e7a18fc7bde874df2acc58e8c2e050c5b5313a10a128cd7a9ddc8": {"added": 1788809892000, "file": {"name": "/ReadersCalendar-v1.0.0.apk", "sha256": "44305395b83e7a18fc7bde874df2acc58e8c2e050c5b5313a10a128cd7a9ddc8", "size": 8617177}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerscalendar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersfeeds": {"metadata": {"added": 1788847786000, "categories": ["Reading", "Internet"], "issueTracker": "https://github.com/funkypitt/readers-feeds/issues", "lastUpdated": 1788847786000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/funkypitt/readers-feeds", "webSite": "https://github.com/funkypitt/readers-feeds", "authorName": "funkypitt", "name": {"en-US": "Reader's Feeds"}, "summary": {"en-US": "Black-and-white, text-only RSS reader"}, "description": {"en-US": "The latest articles of your RSS and Atom sources as a plain list, read as\npages cut at whole lines. Sources, saved articles, OPML and paid Substacks.\nWhite on black or black on white, no icons, no colours; pages instead of\nscrolling for e-ink screens. Born from Pluralis.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"38cd4df17c2e05152c280e4a0d6d59bf4e209f023777d49bec410ab4a82a3b48": {"added": 1788847786000, "file": {"name": "/ReadersFeeds-v1.1.0-arm64.apk", "sha256": "38cd4df17c2e05152c280e4a0d6d59bf4e209f023777d49bec410ab4a82a3b48", "size": 18662853}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.1.0", "versionCode": 2004, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "com.freedomfighter.readersfeeds.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerslauncher": {"metadata": {"added": 1788781692000, "categories": ["System"], "lastUpdated": 1788962322000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-launcher", "authorName": "funkypitt", "name": {"en-US": "Reader's Launcher"}, "summary": {"en-US": "Black-and-white, text-only launcher in the spirit of the Light Phone"}, "description": {"en-US": "Reader's Launcher turns the home screen into a single column of words. No icons,\nno colours, no wallpaper: white on black, or black on white — flip between the two\nwith a double tap, from the \"Reader's theme\" quick-settings tile, or in settings.\n\n* The home screen is one fixed page that never scrolls. Tiles are plain text: an app,\n  or a category that opens a text list of apps.\n* A grid of 3 to 5 squares pinned at the bottom holds the unavoidable apps (phone,\n  messages…) with their icons rendered as monochrome glyphs.\n* Built-in widgets: clock; weather (Open-Meteo, no account, tap for five days);\n  agenda (next event, swipe for the following ones); tasks (first task of a list\n  from Reader's Tasks or Tasks.org, swipe for the following ones, tick to complete,\n  + to add). Standard app widgets can be added too.\n* Swipe up for the alphabetical app list with search and the usual long-press\n  actions (add to home, category, rename, hide, app info, uninstall).\n* Swipe up and hold on the home screen for a text list of recently used apps.\n* Swipe down for notifications. Export and import the whole setup as a JSON file.\n* Two books beside the home screen: swipe right or left to open one (EPUB, MOBI, FB2,\n  plain text), tap to turn pages; each book reopens where you stopped.\n* English by default; French, German, Spanish, Portuguese and Russian follow the\n  device language.\n\nSerif, sans or monospace; three text sizes; left or centred. No ads, no tracking.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"6de329ad04d089a51d258635be202ff6eb0a1a710e35f42ce54a192d7c7f1726": {"added": 1788962322000, "file": {"name": "/ReadersLauncher-v1.12.1.apk", "sha256": "6de329ad04d089a51d258635be202ff6eb0a1a710e35f42ce54a192d7c7f1726", "size": 8511315}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.12.1", "versionCode": 23, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerstasks.permission.ACCESS"}, {"name": "com.freedomfighter.readersbooks.permission.ACCESS"}, {"name": "com.freedomfighter.readersnotes.permission.ACCESS"}, {"name": "com.freedomfighter.readerslauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "94454faf907d08db5b352574864ff8db7ce408bd15a4fd8e89d9159c405c778f": {"added": 1788781692000, "file": {"name": "/ReadersLauncher-v1.6.1.apk", "sha256": "94454faf907d08db5b352574864ff8db7ce408bd15a4fd8e89d9159c405c778f", "size": 8639156}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.6.1", "versionCode": 14, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerstasks.permission.ACCESS"}, {"name": "com.freedomfighter.readerslauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersnotes": {"metadata": {"added": 1788959955000, "categories": ["Writing"], "issueTracker": "https://github.com/funkypitt/readers-notes/issues", "lastUpdated": 1788959955000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-notes", "webSite": "https://github.com/funkypitt/readers-notes", "authorName": "funkypitt", "name": {"en-US": "Reader's Notes"}, "summary": {"en-US": "Black-and-white plain-text notes, synced over WebDAV"}, "description": {"en-US": "One list, one page. A note is a text file whose first line is its title.\nNotes live in a WebDAV folder (kDrive, Nextcloud…) as plain .txt files,\nsynced both ways with conflict copies. White on black or black on white,\nno formatting, no folders, no colours. Shared text becomes a note.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"46657a0d62bdf145a2b95ce654ce2292f8ef5302bd66dca5b72512ff11f326ca": {"added": 1788959955000, "file": {"name": "/ReadersNotes-v1.1.1.apk", "sha256": "46657a0d62bdf145a2b95ce654ce2292f8ef5302bd66dca5b72512ff11f326ca", "size": 8017318}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.1", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readersnotes.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerstasks": {"metadata": {"added": 1788776362000, "categories": ["Writing"], "lastUpdated": 1788959955000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-tasks-android", "authorName": "funkypitt", "name": {"en-US": "Reader's Tasks"}, "summary": {"en-US": "Black-and-white, text-only CalDAV task lists"}, "description": {"en-US": "Reader's Tasks shows the open tasks of a CalDAV list — Infomaniak, Nextcloud,\nTasks.org Cloud, Radicale, any server that stores VTODO — as plain text, white on\nblack or black on white. Tick a box to complete, tap the line at the bottom to add,\nlong press for rename, due tomorrow, delete. \"show n done\" brings completed tasks\nback so a box ticked by mistake can be reopened. Lists can be hidden and reordered.\n\nIt is the task app behind the tasks tile of Reader's Launcher: the launcher reads\nand writes the lists directly, with no permission prompt, since both apps are signed\nwith the same key. The desktop twin for Linux lives at\ngithub.com/funkypitt/readers-tasks.\n\nSerif, sans or monospace; three text sizes. No account with the app itself, no\ntracking: your server, your app password, stored on the phone only.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"6ca3dfc3d1fec9ec5387d5816733cfb62cf4333c726bccde9a307993eb96f9ee": {"added": 1788959955000, "file": {"name": "/ReadersTasks-v1.2.1.apk", "sha256": "6ca3dfc3d1fec9ec5387d5816733cfb62cf4333c726bccde9a307993eb96f9ee", "size": 8079120}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.1", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.freedomfighter.readerstasks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "70762b065507d786263bfb7eb067da9b417554184dfaa956891d6f2d123d2ff2": {"added": 1788776362000, "file": {"name": "/ReadersTasks-v1.0.0.apk", "sha256": "70762b065507d786263bfb7eb067da9b417554184dfaa956891d6f2d123d2ff2", "size": 8214836}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "version