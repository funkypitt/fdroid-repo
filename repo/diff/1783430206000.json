{"repo": {"timestamp": 1784312455000}, "packages": {"com.freedomfighter.retreatplayer": {"metadata": {"added": 1784030307000, "categories": ["Multimedia"], "lastUpdated": 1784142892000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/retreat-player", "authorName": "funkypitt", "name": {"en-US": "Retreat Player"}, "summary": {"en-US": "Plays retreat recordings offline, with nothing able to interrupt them"}, "description": {"en-US": "Retreat Player plays MP3s of dhamma talks, bells, and chanting during a\nmeditation retreat — built on the same principle as Retreat Timer: once\nplayback starts, nothing interrupts it.\n\n* Every recording is downloaded into the app's own storage when it is loaded,\n  so playback needs no network — airplane mode is fine.\n* Playback runs in a foreground service holding a wake lock: the system\n  cannot kill or pause it, even with the screen off for an hour-long talk.\n* The screen stays on while a recording plays — no lock, no screensaver —\n  showing the progress the whole time.\n* A recording plays only because you pressed play, and only once: when it\n  ends, nothing else starts automatically.\n\nLoading and organising:\n\n* Tap + to load recordings from the phone, from a shared kDrive folder\n  (public link — read-only, no password), or from a podcast feed; the link\n  and feed URLs are remembered for next time.\n* Tiles are filed into two sections — Bells & chanting on top (used every\n  day), then Dharma talks — and ordered by hand with arrows.\n* The player shows elapsed and remaining time together, with play, pause,\n  stop, 10-second jumps, and back-to-beginning.\n\nNo ads, no tracking, no accounts.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.retreatplayer/en-US/icon_uTv56QTZcPREA8HitgvFznmtrBkX3CiD_QWp8bnBjyM=.png", "sha256": "b93bf9e904d970f44403c1e2b60bc5ce79adac1917dc2883fd05a9f1b9c18f23", "size": 2941}}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"f0140645038f4c5f1f0d5efddbab6084758b96706d075cf7899b584af87c1f2c": {"added": 1784142892000, "file": {"name": "/RetreatPlayer-v1.2.0.apk", "sha256": "f0140645038f4c5f1f0d5efddbab6084758b96706d075cf7899b584af87c1f2c", "size": 16405046}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 3, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "6c9caaaa7141bfc04ee9f960917c2fc6b30a18adc39b558b71e1e541104216f5": {"added": 1784033566000, "file": {"name": "/RetreatPlayer-v1.1.0.apk", "sha256": "6c9caaaa7141bfc04ee9f960917c2fc6b30a18adc39b558b71e1e541104216f5", "size": 16405046}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "b257f242b685f58a297facc7f087b347577f4f96eb002a62fd2a10bcb541c594": {"added": 1784030307000, "file": {"name": "/RetreatPlayer-v1.0.0.apk", "sha256": "b257f242b685f58a297facc7f087b347577f4f96eb002a62fd2a10bcb541c594", "size": 16954811}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.retreattimer": {"metadata": {"lastUpdated": 1784312455000, "description": {"en-US": "Retreat Timer rings a recording of three singing-bowl bells at the times of day\nyou choose — the signal to begin or end a sitting — so a meditation retreat\nkeeps running on schedule even when the teacher is not present.\n\nBuilt for one job: the bells ring no matter what.\n\n* Exact alarms via the same mechanism the stock Clock app uses, so they fire on\n  time even when the device is locked, asleep, or in Doze for hours.\n* A foreground service holds a wake lock and plays through the alarm stream, so\n  the system cannot mute or kill the bells mid-ring.\n* Alarms are re-armed automatically after a reboot, time change, or app update.\n* A readiness light turns green once battery optimisation and notifications are\n  set, so the teacher can leave knowing the schedule is safe.\n\nEasy to set up:\n\n* Tap + to add the next bell exactly one hour after the last (07:45 then 08:45).\n* Tap any time to edit it; toggle bells on or off; delete with one tap.\n* Per-bell and global Test buttons play the bells at the exact volume the room\n  will hear, set with a slider.\n\nDharma talk library:\n\n* Add talks from this phone, an Infomaniak kDrive public share link, or a\n  podcast RSS feed — every import is downloaded into the app so playback works\n  with no network at all.\n* Play a talk instantly, or schedule one to play at a set time exactly like a\n  bell.\n\nNo ads, no tracking, no accounts. The schedule repeats every day.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.retreattimer/en-US/icon_HS-lg4w-UAGo9yc0MrtwSI_3GERtyaqSNAX7m8e9UIs=.png", "sha256": "1d2fa5838c3e5001a8f7273432bb70488ff718446dc9aa923405fb9bc7bd508b", "size": 2918}}}, "versions": {"6a9360dfed6b37558e6b9dcc610201082a9333f4c2b53379b9697e18c183bd70": {"added": 1784312455000, "file": {"name": "/RetreatTimer-v1.5.0.apk", "sha256": "6a9360dfed6b37558e6b9dcc610201082a9333f4c2b53379b9697e18c183bd70", "size": 19582234}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.5.0", "versionCode": 6, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.USE_EXACT_ALARM"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.freedomfighter.retreattimer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "dev.wath.openlibeextendedeinkremix": {"versions": {"8dbff088979045189c21ea050e46016b6d7bbe631f19f25b17eee25634672eb6": null, "f8c3507d2be381dfc5c5ddc31b0ca64d345e8e24400cc474ad3f22e7f81ab57e": {"added": 1774210436000, "file": {"name": "/OpenLibeExtended-eInk-Remix.apk", "sha256": "f8c3