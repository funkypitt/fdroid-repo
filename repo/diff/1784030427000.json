{"repo": {"timestamp": 1784191825000}, "packages": {"com.freedomfighter.retreatplayer": {"metadata": {"lastUpdated": 1784142892000, "description": {"en-US": "Retreat Player plays MP3s of dhamma talks, bells, and chanting during a\nmeditation retreat — built on the same principle as Retreat Timer: once\nplayback starts, nothing interrupts it.\n\n* Every recording is downloaded into the app's own storage when it is loaded,\n  so playback needs no network — airplane mode is fine.\n* Playback runs in a foreground service holding a wake lock: the system\n  cannot kill or pause it, even with the screen off for an hour-long talk.\n* The screen stays on while a recording plays — no lock, no screensaver —\n  showing the progress the whole time.\n* A recording plays only because you pressed play, and only once: when it\n  ends, nothing else starts automatically.\n\nLoading and organising:\n\n* Tap + to load recordings from the phone, from a shared kDrive folder\n  (public link — read-only, no password), or from a podcast feed; the link\n  and feed URLs are remembered for next time.\n* Tiles are filed into two sections — Bells & chanting on top (used every\n  day), then Dharma talks — and ordered by hand with arrows.\n* The player shows elapsed and remaining time together, with play, pause,\n  stop, 10-second jumps, and back-to-beginning.\n\nNo ads, no tracking, no accounts.\n"}}, "versions": {"f0140645038f4c5f1f0d5efddbab6084758b96706d075cf7899b584af87c1f2c": {"added": 1784142892000, "file": {"name": "/RetreatPlayer-v1.2.0.apk", "sha256": "f0140645038f4c5f1f0d5efddbab6084758b96706d075cf7899b584af87c1f2c", "size": 16405046}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 3, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "6c9caaaa7141bfc04ee9f960917c2fc6b30a18adc39b558b71e1e541104216f5": {"added": 1784033566000, "file": {"name": "/RetreatPlayer-v1.1.0.apk", "sha256": "6c9caaaa7141bfc04ee9f960917c2fc6b30a18adc39b558b71e1e541104216f5", "size": 16405046}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "dev.wath.openlibeextendedeinkremix": {"versions": {"8dbff088979045189c21ea050e46016b6d7bbe631f19f25b17eee25634672eb6": null, "91776abd175cd28f322e00c0390e85f164031f99b78be00aa9353a486deadd61": {"added": 1774210436000, "file": {"name": "/OpenLibeExtended-eInk-Remix.apk", "sha256": "91776abd175cd28f322e00c0390e85f164031f99b78be00aa9353a486deadd61", "size": 91204712}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86_64"], "versionName": "1.3.1", "versionCode": 2019, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.