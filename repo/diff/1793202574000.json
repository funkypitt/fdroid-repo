{"repo": {"timestamp": 1793260780000}, "packages": {"com.freedomfighter.swissbikehike": {"metadata": {"lastUpdated": 1793260779000, "featureGraphic": {"en-US": {"name": "/com.freedomfighter.swissbikehike/en-US/featureGraphic_1iyykHMQQEcc9z9PIudisf62CspKXiwzFulljKL5B5U=.png", "sha256": "d62cb290731040471cf73f4f22e762b1feb60aca4a5e2c3316e9658ca2f90795", "size": 25862}}, "screenshots": {"phone": {"en-US": [{"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/1.png", "sha256": "9cd803b7d7fb19af83f82d6dfba54d944d3d480cfcf960c0041cab536111ada9", "size": 83043}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/2.png", "sha256": "2d5e1045bac9c85f78f5036778fdfae89e98487571284b5a5f82da9bb2b7517b", "size": 512299}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/3.png", "sha256": "00175536612f8c3cc10ad1d288047556ca5cf708828020513f4ba41b7ba7420f", "size": 335329}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/4.png", "sha256": "6216924301d02d8836411efd3e0d33d1f982f127df829056b9b74f9651e1a3d3", "size": 416305}]}}, "name": {"en-US": "Swiss Bikers and Pedestrians Map"}, "summary": {"en-US": "Bike, hike and public-transport map of Switzerland, routing and guidance on the phone"}, "description": {"en-US": "A map for cycling, hiking and public transport in Switzerland, in the spirit of the old\nGPS boxes: one screen, big buttons, the official hiking trails, cycling routes and\npublic-transport lines in their signpost colours on the swisstopo map. Routing runs on\nthe phone (BRouter, OpenStreetMap data), through as many stops as you like, with\nturn-by-turn guidance that goes on with the screen off, an elevation profile and the\ntime of arrival; a GPX track can be followed as it is. Public transport: the next\njourneys to your stop, drawn leg by leg, then guidance in big letters (walk, board, get\noff, change) with real-time timetables online and an optional offline timetable of all\nSwitzerland. Favourites, people and firms from the search.ch directory with your own\nkey, a night map, and the whole country saved offline in one button. Six languages. No\naccount, no tracking.\n"}}, "versions": {"fa8d8ad19e94a0d683b1c234dc8de381a702bc61796b84639dcdb8706dd34b68": null, "6892e470107523d5516bb9800079cc824dc307f7eb098922abf501dd8b737f90": {"added": 1793260779000, "file": {"name": "/SwissBikersPedestriansMap-v0.6.1.apk", "sha256": "6892e470107523d5516bb9800079cc824dc307f7eb098922abf501dd8b737f90", "size": 25033029}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.6.1", "versionCode": 9, "features": [{"name": "android.hardware.vulkan.version"}], "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "com.freedomfighter.swissbikehike.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}