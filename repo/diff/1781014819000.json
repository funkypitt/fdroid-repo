{"repo": {"timestamp": 1781990792000}, "packages": {"200461215f3d72d7675c1a11eb93f079e8669f3c2eade9dbbca352b3f4acc9bc": null, "3326346232432cdae2f6f7b05f6d4fca3fdbecc5e6c14cfe7b7551a73374505b": null, "7f089d2b5b291d4333f4e19e640b836d0c2412642f98674c434776b6a9c5aad4": null, "com.freedomfighter.baristatimer": {"metadata": {"lastUpdated": 1781171027000, "name": {"en-US": "Timer for 9Barista"}, "summary": {"en-US": "Unofficial espresso timer for the 9Barista stovetop machine. 3 taps only."}, "description": {"en-US": "A minimal espresso timer designed for the 9Barista double-boiler stovetop\nespresso machine. Unofficial and fan-made — not affiliated with or endorsed\nby 9Barista Ltd.\n\nThree taps per brew:\n1. Tap to start heating (counts up, warns at 8 minutes)\n2. Tap when espresso appears — starts extraction timer with circular\n   progress ring, turns green in the 25–30 second target zone\n3. Tap when done — shows results and grind adjustment advice\n\nHaptic feedback at 25s (target zone), 30s (over target), and 8 min\n(max heating). Screen stays on during brewing.\n\nTimings based on official 9Barista recommendations:\n• Heating: 3–6 minutes typical\n• Extraction: 25–30 seconds\n• Target output: 35–40g\n\nNo ads. No tracking. No accounts. No permissions beyond vibration.\n"}}, "versions": {"ec648a24e52a38930eada0a362a296f2cc1255189538164c974ad7c5adeeb5f5": {"added": 1781171027000, "file": {"name": "/TimerFor9Barista-v1.1.1.apk", "sha256": "ec648a24e52a38930eada0a362a296f2cc1255189538164c974ad7c5adeeb5f5", "size": 957022}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.1", "versionCode": 3, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.baristatimer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "ead29551caa42c3c318261cec98cda1c43e4