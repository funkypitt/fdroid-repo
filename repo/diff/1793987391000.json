6_64"], "versionName": "1.9.1", "versionCode": 16, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readerstasks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.retreattimer": {"metadata": {"lastUpdated": 1794131896000}, "versions": {"09ba927a070f030acccd2ee7b2cb5ce8324999502b0e031f3354410a5dc67baf": null, "11ec21a756903508c897ca896c3bd75039d84f228e305b28492db10847137189": {"added": 1794131896000, "file": {"name": "/RetreatTimer-v1.14.1.apk", "sha256": "11ec21a756903508c897ca896c3bd75039d84f228e305b28492db10847137189", "size": 17552653}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.14.1", "versionCode": 24, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.SCHEDULE_EXACT_ALARM", "maxSdkVersion": 32}, {"name": "android.permission.USE_EXACT_ALARM"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.retreattimer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.swissbikehike": {"metadata": {"lastUpdated": 1794386444000, "description": {"en-US": "A map for cycling, hiking and public transport in Switzerland, in the spirit of the old\nGPS boxes: one screen, big buttons, the official hiking trails, cycling routes and\npublic-transport lines in their signpost colours on the swisstopo map. Routing runs on\nthe phone (BRouter, OpenStreetMap data), through as many stops as you like, previewed\nbefore you start (distance, time, climb, the streets taken, every turn with its street\nname), then turn-by-turn guidance that goes on with the screen off; a GPX track can be\nfollowed as it is. Public transport: the next\njourneys to your stop, drawn leg by leg, then guidance in big letters (walk, board, get\noff, change) with real-time timetables online and an optional offline timetable of all\nSwitzerland. What is around you, offline: drinking water, shelters, huts, fire places,\nbike shops, bakeries, cafés, restaurants, shops, campsites… from OpenStreetMap, searched by\ncategory or name in one search with addresses, stops and favourites, shown on the map, each with its card (open now, hours, phone, add to\ncontacts). Favourites, people and firms from the\nsearch.ch directory with your own key, which also completes a place with its phone and\naddress; a night map, and the whole country saved offline in one button. A route planner\non every map (start, destination, date and time, share, keep). Six languages. No\naccount, no tracking: the network serves the map tiles, the downloads and searches you\nask for, and the transit map sends your position to transport.opendata.ch to find the\nstops around you.\n"}}, "versions": {"9f9990ec5b00268cc6d2b3430fc369db6b0171d3a0e03c543223c65c7ccc09f9": null, "98bb1c28648a61fcb537b5b2a343471d717a05d081c270f2cbf20010db24a108": {"added": 1794386444000, "file": {"name": "/SwissBikersPedestriansMap-v0.12.0.apk", "sha256": "98bb1c28648a61fcb537b5b2a343471d717a05d081c270f2cbf20010db24a108", "size": 25414126}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.12.0", "versionCode": 24, "features": [{"name": "android.hardware.vulkan.version"}], "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c