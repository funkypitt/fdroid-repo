hat keeps its\nlauncher. A call rings on the whole screen with the caller's photo and name in large type\nand two big buttons; missed calls stay at the top until answered with \"call back\" or \"OK\".\nContacts read favourites, then the people called lately, then everyone, with a search\nfield; a keypad with large keys; the list of calls. When another app is opened during a\ncall, a wide green band stays at the top of the screen with the name and the time on the\nline, and a touch brings the call back. Twelve themes. No account, no network,\nnothing leaves the phone.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.tchitchi.phone/en-US/icon_k9DGhUGa3G_pX1NuVJFiLl3oNUazAarlWOPLnJVW5ws=.png", "sha256": "93d0c685419adc6fe95f536e5491622e5de83546b301aae558e3cb9c9556e70b", "size": 3689}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"26818416e98d8898d7653b5d9a76bd96ccb4201b55c8d4ce2f63615b70c4a499": {"added": 1791211202000, "file": {"name": "/TchitchiPhone-v1.1.0.apk", "sha256": "26818416e98d8898d7653b5d9a76bd96ccb4201b55c8d4ce2f63615b70c4a499", "size": 6087746}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "com.freedomfighter.tchitchi.phone.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}