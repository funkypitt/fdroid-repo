ac82eb6f9674f3665298896c48bff0d8f168e29093": {"added": 1791100376000, "file": {"name": "/ReadersNight-v1.2.0.apk", "sha256": "a0ac53182661c50aacb40eac82eb6f9674f3665298896c48bff0d8f168e29093", "size": 14467490}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 3, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.WRITE_SECURE_SETTINGS"}, {"name": "com.freedomfighter.readersnight.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.tchitchi": {"metadata": {"lastUpdated": 1791108280000, "description": {"en-US": "A Windows Phone 7-style launcher: two columns of big square tiles that scroll. Tiles\nshow each app's last three calls or messages, kept after they are read, and a person's\nphoto calls them at a touch. It can also be the phone app: calls ring on the whole\nscreen with the caller's photo and name in large type and two big buttons, and missed\ncalls stay at the top of the home screen until answered with \"call back\" or \"OK\". The home screen cannot be changed by mistake: a long press\ncounts only after eight seconds, then three questions must each be answered yes.\nTwelve themes. Messages are read from the notifications and kept on the phone only;\nno ads, no tracking.\n"}}, "versions": {"ba5f3846ad375585929f57a0890c5d7d7170c7524e484f557ce1640f2d05a58d": null, "62ac510154ce1a1a59afe599c473942ac0401d1effe35ed7bf8a5d84511eb45e": {"added": 1791108280000, "file": {"name": "/Tchitchi-v0.4.2.apk", "sha256": "62ac510154ce1a1a59afe599c473942ac0401d1effe35ed7bf8a5d84511eb45e", "size": 6071362}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.4.2", "versionCode": 12, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f