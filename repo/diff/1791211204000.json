{"repo": {"timestamp": 1791222902000}, "packages": {"com.freedomfighter.readersphone": {"metadata": {"added": 1791212565000, "categories": ["Phone & SMS"], "lastUpdated": 1791222899000, "license": "MIT", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersphone/en-US/featureGraphic_xUXdGKMF_Oo7HseanQU7ZhCwYtYLEPpGRhPtivZiPQM=.png", "sha256": "c545dd18a305fcea3b1ec79a9d053b6610b062d60b10fa464613ed8af6623d03", "size": 24889}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Phone"}, "summary": {"en-US": "A phone in large type, two colours, that can record a call and write it out"}, "description": {"en-US": "A call rings on the whole screen with the person's photo and name and two big buttons;\nmissed calls stay at the top until answered with \"call back\" or \"OK\". Contacts read\nfavourites, then the people called lately, then everyone; a keypad with large keys; the\nlist of calls. Leave the call for another app and it stays in view: Android's own call\nnotification with one big \"hang up\", and a wide green band that brings the call back.\n\nRecording (off by default): a call is recorded and written out on the phone by\nwhisper.cpp, the model fetched once and shared with the other Reader's apps. Android only\ngives the sound of a call to an accessibility service, so one has to be switched on; the\nsettings say so. Tell the other person — in many countries the law requires it.\n\nSix languages. No account; the network is used only to fetch the model.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersphone/en-US/icon_Y9JU0_KVDzdiHH9dd1fv2tnocRUWvD-uJ0x_Wm2PkLA=.png", "sha256": "63d254d3f2950f37621c7f5d7757efdad9e8711516bc3fae274c7f5a6d8f90b0", "size": 4196}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"6958b7882bd61c7be48014ea05cf9bc38f92d9328d1cefe2aa6958f8c8e7dcba": {"added": 1791222899000, "file": {"name": "/ReadersPhone-v1.0.1.apk"