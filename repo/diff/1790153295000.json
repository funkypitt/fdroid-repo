MISSION"}]}}}}, "com.freedomfighter.readersscanner": {"metadata": {"added": 1790248876000, "categories": ["Office"], "issueTracker": "https://github.com/funkypitt/readers-scanner/issues", "lastUpdated": 1790346786000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-scanner", "webSite": "https://github.com/funkypitt/readers-scanner", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersscanner/en-US/featureGraphic_hm57K5E2069j_s_MGWEgX7Z7zOMwS_mRtO3w9KntEY8=.png", "sha256": "866e7b2b9136d3af63fecfcc1961205fb67bcce3304bf991b4edf0f4a9ed118f", "size": 24461}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Scanner"}, "summary": {"en-US": "Scans to searchable PDFs, text read on the phone"}, "description": {"en-US": "Photographs documents, one page or many: the page is found, straightened and cleaned, a\nblurred shot is flagged at once, and the text is read on the phone in seven languages.\nEach document becomes a searchable PDF named after its date and first words, filed in\nplain folders, shareable as PDF, pictures or text, and copied to your own WebDAV folder\n(kDrive, Nextcloud) if you like.\n\nAt first start you choose the engine: Google ML Kit (most reliable; closed code, needs\nGoogle Play services, sends usage statistics to Google, never your documents) or the free\nones (the app's own page finder and Tesseract). Black and white, text only.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersscanner/en-US/icon_-7nPeJWhGTquQQgMFB4Y8g9d-m7VT6wuRdmO9UJVeXE=.png", "sha256": "fbb9cf7895a1193aae41080c141e18f20f5dfa6ed54fac2e45d98ef542557971", "size": 3984}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"1a7a2438acc68ff69dd0e64305e0f8487a53302fb9acbf9b9b5da21afe498e2e": {"added": 1790346786000, "file": {"name": "/ReadersScanner-v1.0.3.apk", "sha256": "1a7a2438acc68ff69dd0e64305e0f8487a53302fb9acbf9b9b5da21afe498e2e", "size": 40706244}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a"], "versionName": "1.0.3", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.CAMERA"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readersscanner.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}, "antiFeatures": {"NonFreeDep": {"en-US": "If chosen at first start, Google ML Kit's document scanner runs through Google Play services."}, "Tracking": {"en-US": "Only with ML Kit chosen, Google's library sends usage statistics to Google (never the documents). The free engines send nothing."}, "UpstreamNonFree": {"en-US": "The app includes Google ML Kit (closed code), next to the free engines (Tesseract and its own page finder)."}}}}}}}