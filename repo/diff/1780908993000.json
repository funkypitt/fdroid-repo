{"repo": {"timestamp": 1781170429000, "categories": {"System": {"name": {"en-US": "System"}}}}, "packages": {"com.freedomfighter.baristatimer": {"metadata": {"added": 1781014819000, "categories": ["System"], "lastUpdated": 1781170429000, "license": "MIT", "authorName": "funkypitt", "name": {"en-US": "9Barista Timer"}, "summary": {"en-US": "Espresso timer for the 9Barista stovetop machine. 3 taps, nothing more."}, "description": {"en-US": "A minimal espresso timer designed for the 9Barista double-boiler stovetop\nespresso machine.\n\nThree taps per brew:\n1. Tap to start heating (counts up, warns at 8 minutes)\n2. Tap when espresso appears — starts extraction timer with circular\n   progress ring, turns green in the 25–30 second target zone\n3. Tap when done — shows results and grind adjustment advice\n\nHaptic feedback at 25s (target zone), 30s (over target), and 8 min\n(max heating). Screen stays on during brewing.\n\nTimings based on official 9Barista recommendations:\n• Heating: 3–6 minutes typical\n• Extraction: 25–30 seconds\n• Target output: 35–40g\n\nNo ads. No tracking. No accounts. No permissions beyond vibration.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"ead29551caa42c3c318261cec98cda1c43e4489d8a87e3c80c86b8ce8ad1f32c": {"added": 1781170429000, "file": {"name": "/9BaristaTimer-v1.1.0.apk", "sha256": "ead29551caa42c3c318261cec98cda1c43e4489d8a87e3c80c86b8ce8ad1f32c", "size": 957022}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.baristatimer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "4f4933d57384be9a668f18ebb3fccb034f0387cc8ae8c75dea865130fa189d7c": {"added": 1781014819000, "file": {"na