et,\nReader's Launcher tile). Nothing leaves the phone by default. Set up a\nWebDAV folder (kDrive, Nextcloud) in three questions and each recording\ngoes there, where a small worker on your own computer cleans the sound,\nnormalises its loudness and transcribes it with WhisperX; the transcript\nand the cleaned audio come back to the phone. Text only, white on black\nor black on white, six languages.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"6aeb0b7fd109c32d2e8f510def8403b804eb0d0b7260a32777423f288c529a2e": {"added": 1789053287000, "file": {"name": "/ReadersRecorder-v1.1.2.apk", "sha256": "6aeb0b7fd109c32d2e8f510def8403b804eb0d0b7260a32777423f288c529a2e", "size": 13293029}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "1.1.2", "versionCode": 4, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readersrecorder.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerstasks": {"metadata": {"lastUpdated": 1789027249000, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink"}, "versions": {"6ca3dfc3d1fec9ec5387d5816733cfb62cf4333c726bccde9a307993eb96f9ee": null, "0b9b48dc3abec30b0a57fb9c823be43f7773a61c28a8dfcd1ad5edeacaa97040": {"added": 1789027249000, "file": {"name": "/ReadersTasks-v1.3.0.apk", "sha256": "0b9b48dc3abec30b0a57fb9c823be43f7773a61c28a8dfcd1ad5edeacaa97040", "size": 8086920}, "manifest": {"nativecode": 