{"repo": {"timestamp": 1793269637000}, "packages": {"com.freedomfighter.swissbikehike": {"metadata": {"lastUpdated": 1793268113000, "screenshots": {"phone": {"en-US": [{"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/1.png", "sha256": "6ba42f572a7cfb303389a1ebcfd7e48c174f4b0e3e91647037f89df94777ec57", "size": 141702}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/2.png", "sha256": "3fa7501e4d521df9677794b04eec29dd2eeea83040e88150ca40854b60072dce", "size": 1867651}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/3.png", "sha256": "61d852163993e311f97eaf09fa0dc7dc69df945ead6fb50fd01af47af3b0f397", "size": 835702}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/4.png", "sha256": "b1f272faebb9e062b658d986858b46ddc78689e9dcbcc6c2625bfcf2b313ff37", "size": 457444}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/5.png", "sha256": "4638dc933273b504da483fb848303a233e50bb67dc39d46368312e491147aac9", "size": 136105}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/6.png", "sha256": "900c5ca44cb814679965c6fd10f2e9dc83d17d41fea0bf975416105e6ef27689", "size": 1840350}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/7.png", "sha256": "2d5e1045bac9c85f78f5036778fdfae89e98487571284b5a5f82da9bb2b7517b", "size": 512299}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/8.png", "sha256": "00175536612f8c3cc10ad1d288047556ca5cf708828020513f4ba41b7ba7420f", "size": 335329}, {"name": "/com.freedomfighter.swissbikehike/en-US/phoneScreenshots/9.png", "sha256": "6216924301d02d8836411efd3e0d33d1f982f127df829056b9b74f9651e1a3d3", "size": 416305}]}}, "description": {"en-US": "A map for cycling, hiking and public transport in Switzerland, in the spirit of the old\nGPS boxes: one screen, big buttons, the official hiking trails, cycling routes and\npublic-transport lines in their signpost colours on the swisstopo map. Routing runs on\nthe phone (BRouter, OpenStreetMap data), through as many stops as you like, with\nturn-by-turn guidance that goes on with the screen off, an elevation profile and the\ntime of arrival; a GPX track can be followed as it is. Public transport: the next\njourneys to your stop, drawn leg by leg, then guidance in big letters (walk, board, get\noff, change) with real-time timetables online and an optional offline timetable of all\nSwitzerland. Favourites, people and firms from the search.ch directory with your own\nkey, a night map, and the whole country saved offline in one button. A route planner on\nevery map (start, destination, date and time, share, keep, GO). Six languages. No\naccount, no tracking: the network serves the map tiles, the downloads and searches you\nask for, and the transit map sends your position to transport.opendata.ch to find the\nstops around you.\n"}}, "versions": {"8146ed95b16ffd3d696b7f86fff154a065271e6de7d435b8f16ba591f5293b66": null, "f8ecfc210e331de1728ec6c0515388067c131db5aeb01b10862802badbc3d9bc": {"added": 1793268113000, "file": {"name": "/SwissBikersPedestriansMap-v0.7.0.apk", "sha256": "f8ecfc210e331de1728ec6c0515388067c131db5aeb01b10862802badbc3d9bc", "size": 25139581}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.7.0", "versionCode": 14, "features": [{"name": "android.hardware.vulkan.version"}], "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.FO