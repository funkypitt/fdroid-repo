e": "/com.freedomfighter.readersnight/en-US/featureGraphic_RguqcgTYvniFrCGwSvCWrG4EYm9mR8u8vJXrBsRNc2E=.png", "sha256": "460baa7204d8be7885ac21b04af096ac6e04626f6647cbbcbc95eb06c44d7361", "size": 25833}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Night Filter"}, "summary": {"en-US": "Grayscale, warm and dim screen in one tap, from the quick settings"}, "description": {"en-US": "One switch turns the screen gray, as warm as the phone allows, and dim: Android's own\ncolour correction, Night Light and extra dim driven together, and put back as they were\nwhen you switch off. The switch lives in the quick settings, in a home-screen widget and\nin the app. It needs a permission given once from a computer (one adb command, shown in\nthe app); no root. Android does not let an app remove blue entirely, so the tint stops\nat the phone's warmest setting. No network permission, no account, nothing collected.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersnight/en-US/icon_12sp55VSp58dzfmDrBfnoSla8EaaeHuZyA1z-QMZIHU=.png", "sha256": "d76b29e79552a79f1dcdf983ac17e7a1295af0469a787b99c80d73f903192075", "size": 7810}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"066d497139f7d724101b2d379ed1863abb9ea61207f375c88a21017bd75ec6c6": {"added": 1790847552000, "file": {"name": "/ReadersNight-v1.0.0.apk", "sha256": "066d497139f7d724101b2d379ed1863abb9ea61207f375c88a21017bd75ec6c6", "size": 14451106}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.WRITE_SECURE_SETTINGS"}, {"name": "com.freedomfighter.readersnight.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersnotes": {"metad