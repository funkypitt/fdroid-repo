{"repo": {"timestamp": 1793891812000}, "packages": {"com.freedomfighter.rappelsgeants": {"metadata": {"added": 1793891809000, "categories": ["Time"], "lastUpdated": 1793891809000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/rappels-geants", "webSite": "https://github.com/funkypitt/rappels-geants", "screenshots": {"phone": {"fr-FR": [{"name": "/com.freedomfighter.rappelsgeants/fr-FR/phoneScreenshots/1.png", "sha256": "175a9eaf4370a15c3d974c79060403bfd3102be5fd77db75d13d3d92e478d30e", "size": 135365}, {"name": "/com.freedomfighter.rappelsgeants/fr-FR/phoneScreenshots/2.png", "sha256": "cc419926d5d19072c2ee99984b6a73e63697d96216f3df10feaff8ce1d1bfca3", "size": 139172}, {"name": "/com.freedomfighter.rappelsgeants/fr-FR/phoneScreenshots/3.png", "sha256": "e3a2f0327e834e8e0b4c97cdbf0f4c00380d3381161a3c086cb71770184ff09d", "size": 94226}, {"name": "/com.freedomfighter.rappelsgeants/fr-FR/phoneScreenshots/4.png", "sha256": "7f5ab73f8067dc31b6828e411c17a563e4c851c00a810326b1d89790917c2375", "size": 136395}]}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Rappels géants"}, "summary": {"en-US": "Des rappels en plein écran, impossibles à rater, seul ou en famille"}, "description": {"en-US": "À l'heure dite, le rappel couvre tout l'écran, en très gros et en couleur, et sonne\ncomme un réveil : téléphone verrouillé ou par-dessus l'app en cours. Il revient toutes\nles 5 minutes tant qu'on n'a pas touché « C'est fait » ou choisi « dans 5 min / 15 min /\n1 h ». Pensé pour les personnes qui ont un TDAH.\n\n* « Nouveau rappel » : quoi, quand, pour qui, répétition simple.\n* « Toute la famille » : le rappel va dans un agenda Google partagé par la famille\n  (par exemple « Famille important ») et sonne sur chaque téléphone où l'app est\n  installée ; tout ce que contient cet agenda sonne aussi.\n* « Depuis mon agenda » : un événement de n'importe quel agenda du téléphone (Google,\n  CalDAV par DAVx5…) devient un rappel géant, au début ou un peu avant.\n* Configuration guidée, une chose par page, avec un essai à la fin.\n\nSans compte, sans serveur, sans publicité. Français et anglais.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.rappelsgeants/en-US/icon_v0QsLrTjzimcKCj-xf48QTewHWZRnklMmcUYbuRjPl0=.png", "sha256": "bf442c2eb4e3ce299c2828fec5fe3c4137b01d66519e494c99c5186ee4633e5d", "size": 10547}, "fr-FR": {"name": "/com.freedomfighter.rappelsgeants/fr-FR/icon_v0QsLrTjzimcKCj-xf48QTewHWZRnklMmcUYbuRjPl0=.png", "sha256": "bf442c2eb4e3ce299c2828fec5fe3c4137b01d66519e494c99c5186ee4633e5d", "size": 10547}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"b012182f2473be706aed4a7c3fd56633d2ffd2bba5b146d021d05a13fb4c1eea": {"added": 1793891809000, "file": {"name": "/RappelsGeants-v0.1.0.apk", "sha256": "b012182f2473be706aed4a7c3fd56633d2ffd2bba5b146d021d05a13fb4c1eea", "size": 2562258}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 35}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.USE_EXACT_ALARM"}, {"name": "android.permission.SCHEDULE_EXACT_ALARM", "maxSdkVersion": 32}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "com.freedomfighter.rappelsgeants.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersbooks": {"metadata": {"lastUpdated": 1793808021000}, "versions": {"c4c298df9c630b49071dc2b3a057d6a41ac89575018c54061772e862f79cd6e0": null, "ecba00106