onName": "1.25.1", "versionCode": 46, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerstasks.permission.ACCESS"}, {"name": "com.freedomfighter.readersbooks.permission.ACCESS"}, {"name": "com.freedomfighter.readersnotes.permission.ACCESS"}, {"name": "com.freedomfighter.readersmindful.permission.ACCESS"}, {"name": "com.freedomfighter.readersrecorder.permission.ACCESS"}, {"name": "com.freedomfighter.readerslauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersmotivation": {"metadata": {"added": 1792485596000, "categories": ["Sports & Health"], "issueTracker": "https://github.com/funkypitt/readers-motivation/issues", "lastUpdated": 1792485596000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-motivation", "webSite": "https://github.com/funkypitt/readers-motivation", "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/apps", "name": {"en-US": "Reader's Motivation"}, "summary": {"en-US": "Count the days, and the urges you beat; a slip never wipes what you earned"}, "description": {"en-US": "For something to stop (sugar, cigarettes, alcohol, screens in the evening) or something\nto do every day. One page per habit: the day in big letters, the urges beaten, what you\navoided in units and money, the next step, your own reason, the last weeks as squares.\nA slip costs one day and nothing else: the totals never go down, the headline that day is\nwhat stays earned, and the app gives your plan back. \"An urge, right now\": three minutes\nwith a breathing ring, your reason and your plan, then \"it passed\" or \"I slipped\". A plan\ndecided in advance, a start date that marks a fresh start, one line to tell someone where\nyou are. Widget with a ✓ that counts an urge beaten, optional daily reminder, backup.\nEach choice comes from the published research on habits and lapses. Text only, white on\nblack, six languages, no network permission.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"816928a9e37f074a3163f1f30e809a7871c99448d9fa0cc3b43c4d4155f637d0": {"added": 1792485596000, "file": {"name": "/ReadersMotivation-v1.0.1.apk", "sha256": "816928a9e37f074a3163f1f30e809a7871c99448d9fa0cc3b43c4d4155f637d0", "size": 14651754}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.1", "versionCode": 2, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readersmotivation.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersphone": {"metadata": {"added": 1792439225000, "lastUpdated": 1792439225000}, "versions": {"333e3c3ccb734d3ed7eaef357fca9ec6bf41492014f010f20a93efeceda07a0a": null, "eb6f4bb68a0b8166ad906af391d7715785edb13ef7966e7c8d37075c59c43f16": {"added": 1792439225000, "file": {"name": "/ReadersPhone-v1.3.1.apk", "sha256": "eb6f4bb68a0b8166ad906af391d7715785edb13ef7966e7c8d37075c59c43f16", "size": 36202173}, "manifest": {"nativecode": ["arm64-v8a