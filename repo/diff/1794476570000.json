{"repo": {"timestamp": 1794484794000}, "packages": {"com.freedomfighter.readersvideoeditor": {"metadata": {"added": 1794484792000, "categories": ["Multimedia"], "lastUpdated": 1794484792000, "license": "MIT", "featureGraphic": {"en-US": {"name": "/com.freedomfighter.readersvideoeditor/en-US/featureGraphic_u6tTOosS8rSWXmn32yz9fQ8r32eRXspds4f9sEy7kXs=.png", "sha256": "bbab533a8b12f2b4965e69f7db2cfd7d0f2bdf67915eca5db387fdb04cbb917b", "size": 20567}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Video Editor"}, "summary": {"en-US": "Cut a video by marking its transcript, entirely on the phone"}, "description": {"en-US": "Open a video or a sound recording: the app writes down what is said, and you mark on\nthe text, as with a highlighter, the passages to keep or to cut. Listen to the edit,\nthen produce it as a video or a sound file, with soft joins and, if you like, a square\npicture. Cutting by whole sentences is the most precise; within a sentence a cut can\nfall a little off. The transcription runs on the phone, slowly but without an account\nor a network: the only download is the transcription model, once, when you ask.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersvideoeditor/en-US/icon_Y8QvExDN6Yb66NsDrkoNiHqZlFncuag8caQH_XfWkzo=.png", "sha256": "63c42f1310cde986fae8db03ae4a0d887a999459dcb9a83c71a407fd77d6933a", "size": 1246}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"9a980b951f141a72efb4c25dcb496b2d438e2743e849691550d0c300e9ba6533": {"added": 1794484792000, "file": {"name": "/ReadersVideoEditor-v0.1.3.apk", "sha256": "9a980b951f141a72efb4c25dcb496b2d438e2743e849691550d0c300e9ba6533", "size": 31175328}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "0.1.3", "versionCode": 4, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 36}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a