rName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Podcasts"}, "summary": {"en-US": "Podcasts in black and white — subscribe, download, listen, nothing else"}, "description": {"en-US": "A podcast player with nothing on the screen but lines of text. Subscribe by pasting the\naddress of a feed or by sharing a link to the app; the episodes wait in one of three lists —\nwhat is on the phone or already begun, what is new across all the channels, or one channel at\na time. An episode is downloaded or played straight over the connection, resumes exactly where\nit was left, and once heard through is marked and its file let go.\n\nSubscriptions travel as OPML, which any podcast app reads, and the settings — with the place\neach episode was left — as a JSON file. Those two files are the whole of the synchronisation\nwith the desktop twin: there is no server and no account, and nothing leaves the phone but the\nrequests to the feeds themselves.\n\nEnglish, French, German, Spanish, Portuguese and Russian; white on black or black on white,\nthree fonts, three text sizes.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"43184f62d795acab44e0c21767400e2214aba11068b43886abac16d25e4a01a6": {"added": 1789743107000, "file": {"name": "/ReadersPodcasts-v0.2.0.apk", "sha256": "43184f62d795acab44e0c21767400e2214aba11068b43886abac16d25e4a01a6", "size": 20633323}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.2.0", "versionCode": 5, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_