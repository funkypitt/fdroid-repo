{"repo": {"timestamp": 1788845079000}, "packages": {"com.freedomfighter.readersbooks": {"metadata": {"added": 1788845077000, "categories": ["Reading"], "issueTracker": "https://github.com/funkypitt/readers-books/issues", "lastUpdated": 1788845077000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-books", "webSite": "https://github.com/funkypitt/readers-books", "authorName": "funkypitt", "name": {"en-US": "Reader's Books"}, "summary": {"en-US": "Black-and-white e-book reader with a shelf"}, "description": {"en-US": "A shelf of books as a plain list, and pages of plain text cut at whole\nlines. EPUB, MOBI, FB2 and text files, opened from the app, a file manager\nor a share. Tap halves to turn pages, long press for chapters and text\nsize. Position remembered per book. White on black or black on white.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"dab78f048c0cb92cbb4ebe59e8ee8ed5ba3af634cc2b3dda2f0d25ef98a2bdd3": {"added": 1788845077000, "file": {"name": "/ReadersBooks-v1.0.0.apk", "sha256": "dab78f048c0cb92cbb4ebe59e8ee8ed5ba3af634cc2b3dda2f0d25ef98a2bdd3", "size": 8146914}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readersbooks.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersfeeds": {"metadata": {"added": 1788815246000, "lastUpdated": 1788815246000}, "versions": {"0625da4ffdbc9d2bd15bb1e27e3ba5b6d32aaded966b99433ac2dcda29a73368": null, "7f5317b50b56d7c577997311fafca28fdc5024b312ad15346bf8853afeb7cfcc": {"added": 1788815246000, "file": {"name": "/ReadersFeeds-v1.0.2-arm64.apk", "sha256": "7f5317b50b56d7c577997311fafca28fdc5024b312ad15346bf8853afeb7cfcc