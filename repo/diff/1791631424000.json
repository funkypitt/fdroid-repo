sks \"what for?\" and waits a few\nseconds (longer in the evening, or with the reason typed), then leaves the app alone for\nten minutes; a one-line word after fifteen minutes. The data is Android's own usage\nrecord, read with the \"usage access\" permission; nothing leaves the phone, no network\npermission. Text only, white on black.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"1cab26fa49fc357bae763c1a49c2349b83b08fcb2283709f86372786b62486c4": {"added": 1791742095000, "file": {"name": "/ReadersAttention-v1.1.0.apk", "sha256": "1cab26fa49fc357bae763c1a49c2349b83b08fcb2283709f86372786b62486c4", "size": 14582066}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "com.freedomfighter.readersattention.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersaudio": {"metadata": {"lastUpdated": 1791717520000}, "versions": {"f51dc44a8d1a33cf736f255fb5267fc27a4b8207d04928db628065832fc3c2ec": null, "a418a4991e368b1ec2b23d980f24683da370c2a31dc8861e67a33bae34dfe0da": {"added": 1791717520000, "file": {"name": "/ReadersAudio-v1.7.0.apk", "sha256": "a418a4991e368b1ec2b23d980f24683da370c2a31dc8861e67a33bae34dfe0da", "size": 51284442}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "1.7.0", "versionCode": 15, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, 