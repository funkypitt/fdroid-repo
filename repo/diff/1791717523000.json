{"repo": {"timestamp": 1791961894000}, "packages": {"com.freedomfighter.readersattention": {"metadata": {"added": 1791721595000, "categories": ["System"], "issueTracker": "https://github.com/funkypitt/readers-attention/issues", "lastUpdated": 1791742095000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-attention", "webSite": "https://github.com/funkypitt/readers-attention", "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/apps", "name": {"en-US": "Reader's Attention"}, "summary": {"en-US": "The apps opened by reflex, counted in words, with a pause before them"}, "description": {"en-US": "Not the screen time but the use to no purpose: the apps opened by reflex (social\nnetworks, games, short video). Each day, in words: how many times they were opened and\nfor how long, what came first after unlocking, the longest stretch, the evening, the\nquick checks under a minute. A tap moves any app between \"reflex\" and \"tools\". Off by\ndefault and never blocking: a pause before a reflex app asks \"what for?\" and waits a few\nseconds (longer in the evening, or with the reason typed), then leaves the app alone for\nten minutes; a one-line word after fifteen minutes. The data is Android's own usage\nrecord, read with the \"usage access\" permission; nothing leaves the phone, no network\npermission. Text only, white on black.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"1cab26fa49fc357bae763c1a49c2349b83b08fcb2283709f86372786b62486c4": {"added": 1791742095000, "file": {"name": "/ReadersAttention-v1.1.0.apk", "sha256": "1cab26fa49fc357bae763c1a49c2349b83b08fcb2283709f86372786b62486c4", "size": 14582066}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermi