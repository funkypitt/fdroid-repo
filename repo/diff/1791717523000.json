{"repo": {"timestamp": 1791721597000}, "packages": {"com.freedomfighter.readersattention": {"metadata": {"added": 1791721595000, "categories": ["System"], "issueTracker": "https://github.com/funkypitt/readers-attention/issues", "lastUpdated": 1791721595000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-attention", "webSite": "https://github.com/funkypitt/readers-attention", "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/apps", "name": {"en-US": "Reader's Attention"}, "summary": {"en-US": "The apps opened by reflex, counted in words, with a pause before them"}, "description": {"en-US": "Not the screen time but the use to no purpose: the apps opened by reflex (social\nnetworks, games, short video). Each day, in words: how many times they were opened and\nfor how long, what came first after unlocking, the longest stretch, the evening, the\nquick checks under a minute. A tap moves any app between \"reflex\" and \"tools\". Off by\ndefault and never blocking: a pause before a reflex app asks \"what for?\" and waits a few\nseconds (longer in the evening, or with the reason typed), then leaves the app alone for\nten minutes; a one-line word after fifteen minutes. The data is Android's own usage\nrecord, read with the \"usage access\" permission; nothing leaves the phone, no network\npermission. Text only, white on black.\n"}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"48c41863f975d0d568642564e97c9172c6fbaf34098ae42541dead0207b8ea7d": {"added": 1791721595000, "file": {"name": "/ReadersAttention-v1.0.0.apk", "sha256": "48c41863f975d0d568642564e97c9172c6fbaf34098ae42541dead0207b8ea7d", "size": 14565682}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "com.freedomfighter.readersattention.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerspodcasts": {"metadata": {"lastUpdated": 1791719665000}, "versions": {"7e829b0824d9be2955f0002dceec929b459b40960e596b23cce10db90d449a4e": null, "4ada82f5032a4fc9f6829a092de9ac1647a596a87c500a3c195848e44e1a0e34": {"added": 1791719665000, "file": {"name": "/ReadersPodcasts-v1.6.0.apk", "sha256": "4ada82f5032a4fc9f6829a092de9ac1647a596a87c500a3c195848e44e1a0e34", "size": 38202161}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.6.0", "versionCode": 24, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerspodcasts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}}}