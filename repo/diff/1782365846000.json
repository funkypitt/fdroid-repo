TWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "f0140645038f4c5f1f0d5efddbab6084758b96706d075cf7899b584af87c1f2c": {"added": 1784142892000, "file": {"name": "/RetreatPlayer-v1.2.0.apk", "sha256": "f0140645038f4c5f1f0d5efddbab6084758b96706d075cf7899b584af87c1f2c", "size": 16405046}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.2.0", "versionCode": 3, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "6c9caaaa7141bfc04ee9f960917c2fc6b30a18adc39b558b71e1e541104216f5": {"added": 1784033566000, "file": {"name": "/RetreatPlayer-v1.1.0.apk", "sha256": "6c9caaaa7141bfc04ee9f960917c2fc6b30a18adc39b558b71e1e541104216f5", "size": 16405046}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "b257f242b685f58a297facc7f087b347577f4f96eb002a62fd2a10bcb541c594": {"added": 1784030307000, "file": {"name": "/RetreatPlayer-v1.0.0.apk", "sha256": "b257f242b685f58a297facc7f087b347577f4f96eb002a62fd2a10bcb541c594", "size": 16954811}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.retreattimer": {"metadata": {"added": 1782379054000, "categories": ["Time"], "lastUpdated": 1785394662000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/retreat-timer", "authorName": "funkypitt", "name": {"en-US": "Retreat Timer"}, "summary": {"en-US": "Rings one or three meditation bells on schedule, even in deep sleep"}, "description": {"en-US": "Retreat Timer rings a recording of singing-bowl bells at the times of day you\nchoose — the signal to begin or end a sitting — so a meditation retreat keeps\nrunning on schedule even when the teacher is not present. Each time can ring\nthree bells or a single bell, whichever that moment in the day calls for.\n\nBuilt for one job: the bells ring no matter what.\n\n* Exact alarms via the same mechanism the stock Clock app uses, so they fire on\n  time even when the device is locked, asleep, or in Doze for hours.\n* A foreground service holds a wake lock and plays through the alarm stream, so\n  the system cannot mute or kill the bells mid-ring.\n* Alarms are re-armed automatically after a reboot, time change, or app update.\n* A readiness light turns green once battery optimisation and notifications are\n  set, so the teacher can leave knowing the schedule is safe.\n\nEasy to set up:\n\n* Tap Add bell and pick the time. The picker opens ready for typing, so any\n  minute is set directly — 06:47, not just 06:45 — with a dial one tap away.\n* In that same picker, choose three bells or one for this time — three to open\n  and close a sitting, one for the smaller markers in a day. Preview either\n  before setting it. The schedule shows a small x3 or x1 badge beside every\n  bell, so which rings which is readable at a glance.\n* Tap any time to edit it — and its number of bells; toggle bells on or off;\n  delete with one tap.\n* Four bell sounds to choose from — singing bell, Tibetan E flat bowl, gong\n  bowl and Satipanya — all matched to the same loudness, so switching changes\n  the timbre and never the volume. One bell and three bells are matched too.\n* Bell volume and talk volume are set separately, because a spoken recording\n  normally has to be much louder than a bowl strike to fill the same room.\n  Each has its own Test button that plays at the exact level the room will\n  hear. Test bell rings once, which is all it takes to judge the level, and\n  Test talk uses the talk that is actually coming up next.\n\nDharma talk library:\n\n* Add talks from this phone, an Infomaniak kDrive public share link, or a\n  podcast RSS feed — every import is downloaded into the app so playback works\n  with no network at all.\n* Play a talk instantly, or schedule one to play at a set time exactly like a\n  bell.\n* A player bar with a draggable progress bar — talks often open with minutes\n  of silence, so drag straight to the speech instead of waiting it out.\n  Restart, 10 seconds back and forward, pause, and both elapsed and remaining\n  time, from the app or the notification.\n* Optional \"keep Bluetooth speaker awake\": portable speakers disconnect after\n  a few minutes of silence, so the next bell would come faintly from the\n  tablet. Turn it on when using an external speaker and it plays a\n  barely-audible sound between bells to hold the link open. The bells are\n  untouched — still the exact-alarm system, this is only a separate faint\n  stream.\n\nNo ads, no tracking, no accounts. The schedule repeats every day.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.retreattimer/en-US/icon_HS-lg4w-UAGo9yc0MrtwSI_3GERtyaqSNAX7m8e9UIs=.png", "sha256": "1d2fa5838c3e5001a8f7273432bb70488ff718446dc9aa923405fb9bc7bd508b", "size": 2918}}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"337d16347d5eb7ca9b9d55c084f9c521ff9ca1da43c8981917ea3093332936e2": {"added": 1785394662000, "file": {"name": "/RetreatTimer-v1.11.0.apk", "sha256": "337d16347d5eb7ca9b9d55c084f9c521ff9ca1da43c8981917ea3093332936e2", "size": 22774111}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.11.0", "versionCode": 18, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.USE_EXACT_ALARM"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": 