{"repo": {"timestamp": 1788625803000, "categories": {"Time": {"name": {"en-US": "Time"}}}}, "packages": {"app.mp4tomp3": {"metadata": {"added": 1785398194000, "categories": ["Multimedia"], "issueTracker": "https://github.com/funkypitt/mp4-to-mp3/issues", "lastUpdated": 1785398194000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/funkypitt/mp4-to-mp3", "webSite": "https://github.com/funkypitt/mp4-to-mp3", "authorName": "funkypitt", "name": {"en-US": "MP4 to MP3"}, "summary": {"en-US": "Convert videos to 320 kbps MP3 files and share them"}, "description": {"en-US": "An app that does one thing: turn videos into MP3 files.\n\nPick one or more videos, and each one's audio track is extracted and\nre-encoded to a 320 kbps CBR MP3 saved in your Downloads folder. When\nit is done you get a list of the files, each with a Share button — so\nsending them to a cloud folder, Telegram, WhatsApp or anywhere else\nis one tap away.\n\n* 320 kbps constant bitrate, encoded with LAME\n* Batch conversion — pick as many videos as you like\n* Saved straight to Downloads, visible in your file manager\n* Share individual files or all of them at once\n* Works with anything your phone can play: MP4, MKV, WebM, 3GP…\n* Videos can also be sent to the app from another app's share sheet\n* Conversion keeps running when you leave the app\n\nNo accounts, no network access, no ads, no tracking. Everything\nhappens on the device.\n\nBundles LAME 3.100 (LGPL-2.1-or-later).\n"}, "icon": {"en-US": {"name": "/app.mp4tomp3/en-US/icon_DY_lmTsQZeG35ncDAQgR5mUaG8fwI1YTUtbgjCs-Dek=.png", "sha256": "0d8fe5993b1065e1b7e67703010811e6651a1bc7f023561352d6e08c2b3e0de9", "size": 4062}}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"76d0625840c83ba414630f78625811615f96e3b8284d162094ecea584ce8eeb2": {"added": 1785398194000, "file": {"name": "/MP4-to-MP3-v1.0.0.apk", "sha256": "76d0625840c83ba414630f78625811615f96e3b8284d162094ecea584ce8eeb2", "size": 2250385}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 29, "targetSdkVersion": 35}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "app.mp4tomp3.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readerslauncher": {"metadata": {"added": 1788624054000, "categories": ["System"], "lastUpdated": 1788625803000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/readers-launcher", "authorName": "funkypitt", "name": {"en-US": "Reader's Launcher"}, "summary": {"en-US": "Black-and-white, text-only launcher in the spirit of the Light Phone"}, "description": {"en-US": "Reader's Launcher turns the home screen into a single column of words. No icons,\nno colours, no wallpaper: white on black, or black on white — flip between the two\nwith a double tap, from the \"Reader's theme\" quick-settings tile, or in settings.\n\n* Tiles are plain text: an app, or a category that opens a text list of apps.\n* A grid of 3 to 5 squares pinned at the bottom holds the unavoidable apps (phone,\n  messages…) with their icons rendered as monochrome glyphs.\n* Built-in widgets: clock; weather (Open-Meteo, no account, tap for five days);\n  agenda (next event, swipe for the following ones); tasks (first task of a\n  Tasks.org list, tick to complete, + to add — Tasks.org syncs with CalDAV, Google\n  Tasks, Microsoft To Do or keeps lists offline). Standard app widgets can be added too.\n* Swipe up for the alphabetical app list with search and the usual long-press\n  actions (add to home, category, rename, hide, app info, uninstall).\n* Swipe up and hold on the home screen for a text list of recently used apps.\n* Swipe down for notifications. Export and import the whole setup as a JSON file.\n\nSerif, sans or monospace; three text sizes; left or centred. No ads, no tracking.\n"}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"976a4eba11b2d2e3ea37dceae5f536d55dc08b8c0a958f6625b034c1d7dec4d9": {"added": 1788625803000, "file": {"name": "/ReadersLauncher-v1.1.0.apk", "sha256": "976a4eba11b2d2e3ea37dceae5f536d55dc08b8c0a958f6625b034c1d7dec4d9", "size": 8457997}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.0", "versionCode": 2, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerslauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "b8f699ac66b407eda9f20a4d7e54f106b335b97052c590843fcf5ddaea278e28": {"added": 1788624054000, "file": {"name": "/ReadersLauncher-v1.0.0.apk", "sha256": "b8f699ac66b407eda9f20a4d7e54f106b335b97052c590843fcf5ddaea278e28", "size": 9448817}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "com.freedomfighter.readerslauncher.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.retreatplayer": {"metadata": {"added": 1784030307000, "categories": ["Multimedia"], "lastUpdated": 1785178276000, "license": "MIT", "sourceCode": "https://github.com/funkypitt/retreat-player", "authorName": "funkypitt", "name": {"en-US": "Retreat Player"}, "summary": {"en-US": "Plays retreat recordings offline, with nothing able to interrupt them"}, "description": {"en-US": "Retreat Player plays MP3s of dhamma talks, bells, and chanting during a\nmeditation retreat — built on the same principle as Retreat Timer: once\nplayback starts, nothing interrupts it.\n\n* Every recording is downloaded into the app's own storage when it is loaded,\n  so playback needs no network — airplane mode is fine.\n* Playback runs in a foreground service holding a wake lock: the system\n  cannot kill or pause it, even with the screen off for an hour-long talk.\n* The screen stays on while a recording plays — no lock, no screensaver —\n  showing the progress the whole time.\n* A recording plays only because you pressed play, and only once: when it\n  ends, nothing else starts automatically.\n\nLoading and organising:\n\n* Tap + to load recordings from the phone, from a shared kDrive folder\n  (public link — read-only, no password), or from a podcast feed; the link\n  and feed URLs are remembered for next time.\n* Tiles are filed into two sections — Bells & chanting on top (used every\n  day), then Dharma talks — and ordered by hand with arrows.\n* The player shows elapsed and remaining time together, with play, pause,\n  stop, 10-second jumps, and back-to-beginning.\n\nNo ads, no tracking, no accounts.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.retreatplayer/en-US/icon_uTv56QTZcPREA8HitgvFznmtrBkX3CiD_QWp8bnBjyM=.png", "sha256": "b93bf9e904d970f44403c1e2b60bc5ce79adac1917dc2883fd05a9f1b9c18f23", "size": 2941}}, "preferredSigner": "9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"}, "versions": {"e0052bbef42a011392636fcef6f2fdef9077b82ff4f5214a1c337d7304705b32": {"added": 1785178276000, "file": {"name": "/RetreatPlayer-v1.5.0.apk", "sha256": "e0052bbef42a011392636fcef6f2fdef9077b82ff4f5214a1c337d7304705b32", "size": 16421498}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.5.0", "versionCode": 7, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "com.freedomfighter.retreatplayer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "56c04f4e291448bcaf53e4027d8fd037aaba704611cdfb6b506138f0a24c9d28": {"added": 1785163322000, "file": {"name": "/RetreatPlayer-v1.4.0.apk", "sha256": "56c04f4e291448bcaf53e4027d8fd037aaba704611cdfb6b506138f0a24c9d28", "size": 16421498}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.4.0", "versionCode": 6, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897