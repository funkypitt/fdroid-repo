launcher: two columns of big square tiles that scroll. Tiles\nshow each app's last three calls or messages, kept after they are read, and a person's\nphoto calls them at a touch. The home screen cannot be changed by mistake: a long press\ncounts only after eight seconds, then three questions must each be answered yes.\nTwelve themes. Messages are read from the notifications and kept on the phone only;\nno ads, no tracking.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.tchitchi/en-US/icon_k4-grwcmphnp1dEFBk08iXEwN0O3dc6X8NvZ1qp8x10=.png", "sha256": "938fa0af0726a619e9d5d105064d3c8971303743b775ce97f0dbd9d6aa7cc75d", "size": 1291}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"ba5f3846ad375585929f57a0890c5d7d7170c7524e484f557ce1640f2d05a58d": {"added": 1790869677000, "file": {"name": "/Tchitchi-v0.3.1.apk", "sha256": "ba5f3846ad375585929f57a0890c5d7d7170c7524e484f557ce1640f2d05a58d", "size": 5968906}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.3.1", "versionCode": 8, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerstasks.permission.ACCESS"}, {"name": "com.freedomfighter.readersbooks.permission.ACCESS"}, {"name": "com.freedomfighter.readersnotes.permission.ACCESS"}, {"name": "com.freedomfighter.readersmindful.permission.ACCESS"}, {"name": "com.freedomfighter.readersrecorder.permission.ACCESS"}, {"name": "com.freedomfighter.tchitchi.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.parentcontrol.socialblocker.detox": {"metadata": {"lastUpdated": 1790930610000, "description": {"en-US": "Blocks YouTube, Instagram, TikTok, Reddit, X and Substack outside the hours you\nallow. The filtering happens on the device: no proxy, no certificate, no account.\nWhile it blocks, sites and hours are locked, and five maths problems can stand\nbetween you and stopping it. Friction you choose, not parental control. Works on\nIPv6-only carriers. Black and white, text only, six languages.\n\nOnly the names of the sites you look up pass through the app, never the traffic\nitself. They go to your network's own name servers as usual; if those do not\nanswer, the app asks Quad9, a Swiss non-profit name service, so that the phone\nkeeps working.\n"}}, "versions": {"9e5a45e8c6d7ea86b39f5dba921f7f902bd10784755e7757bcdf572cd3927397": null, "5b07b8329ae04d35c0c26d8c457aee0c6bad980d2513f362f438d5858f7b9ece": {"added": 1790930610000, "file": {"name": "/SocialDetox-v1.7.2-detox.apk", "sha256": "5b07b8329ae04d35c0c26d8c457aee0c6bad980d2513f362f438d5858f7b9ece", "size": 5206382}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.7.2-detox", "versionCode": 11, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 34}, "signer": {"sha256": ["9b6ae69650b1ccf5bfa08ad15dc8b412622b8e5a3202ea066215067897a2be28"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android