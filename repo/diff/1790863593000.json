{"repo": {"timestamp": 1790869679000}, "packages": {"com.freedomfighter.tchitchi": {"metadata": {"lastUpdated": 1790869677000, "description": {"en-US": "A Windows Phone 7-style launcher: two columns of big square tiles that scroll. Tiles\nshow each app's last three calls or messages, kept after they are read, and a person's\nphoto calls them at a touch. The home screen cannot be changed by mistake: a long press\ncounts only after eight seconds, then three questions must each be answered yes.\nTwelve themes. Messages are read from the notifications and kept on the phone only;\nno ads, no tracking.\n"}}, "versions": {"8069a4ec1762686313eaf46cae21b57617b6bcf6ed20b6872d94263af7c76c24": null, "ba5f3846ad375585929f57a0890c5d7d7170c7524e484f557ce1640f2d05a58d": {"added": 1790869677000, "file": {"name": "/Tchitchi-v0.3.1.apk", "sha256": "ba5f3846ad375585929f57a0890c5d7d7170c7524e484f557ce1640f2d05a58d", "size": 5968906}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.3.1", "versionCode": 8, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.QUERY_ALL_PACKAGES"}, {"name": "android.permission.REQUEST_DELETE_PACKAGES"}, {"name": "android.permission.EXPAND_STATUS_BAR"}, {"name": "android.permission.BIND_APPWIDGET"}, {"name": "android.permission.PACKAGE_USAGE_STATS"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "org.tasks.permission.READ_TASKS"}, {"name": "org.tasks.permission.WRITE_TASKS"}, {"name": "com.freedomfighter.readerstasks.permission.ACCESS"}, {"name": "com.freedomfighter.readersbooks.permission.A