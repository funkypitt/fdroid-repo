, "size": 25833}}, "authorName": "Pierre Gallaz", "authorWebSite": "https://gallaz.ch/eink", "name": {"en-US": "Reader's Night Filter"}, "summary": {"en-US": "Grayscale, warm and dim screen in one tap, from the quick settings"}, "description": {"en-US": "One switch turns the screen gray, as warm as the phone allows, and dim: Android's own\ncolour correction, Night Light and extra dim driven together, and put back as they were\nwhen you switch off. The switch lives in the quick settings, in a home-screen widget and\nin the app. It needs a permission given once from a computer (one adb command, shown in\nthe app); no root. Android does not let an app remove blue entirely, so the tint stops\nat the phone's warmest setting. No network permission, no account, nothing collected.\n"}, "icon": {"en-US": {"name": "/com.freedomfighter.readersnight/en-US/icon_12sp55VSp58dzfmDrBfnoSla8EaaeHuZyA1z-QMZIHU=.png", "sha256": "d76b29e79552a79f1dcdf983ac17e7a1295af0469a787b99c80d73f903192075", "size": 7810}}, "preferredSigner": "b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"}, "versions": {"066d497139f7d724101b2d379ed1863abb9ea61207f375c88a21017bd75ec6c6": {"added": 1790847552000, "file": {"name": "/ReadersNight-v1.0.0.apk", "sha256": "066d497139f7d724101b2d379ed1863abb9ea61207f375c88a21017bd75ec6c6", "size": 14451106}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.0.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 28, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.WRITE_SECURE_SETTINGS"}, {"name": "com.freedomfighter.readersnight.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.freedomfighter.readersscanner": {"metadata": {"lastUpdated": 1790538343000, "description": {"en-US": "Photographs documents, one page or many: the page is found, straightened and cleaned, a\nblurred shot is flagged at once, and the text is read on the phone in seven languages.\nEach document becomes a searchable PDF, dated and named by you, filed in\nplain folders, shareable as PDF, pictures or text, and copied to your own WebDAV folder\n(kDrive, Nextcloud) if you like.\n\nAt first start you choose the engine: Google ML Kit (most reliable; closed code, needs\nGoogle Play services, sends usage statistics to Google, never your documents) or the free\nones (the app's own page finder and Tesseract). Black and white, text only.\n"}}, "versions": {"d8948c1b924ed42fb2656a51c57194578a64eeb72227581241f264bf42929708": null, "82e4f9e0b68c351d2381d1041fcc622453297899299cf124f48ade02a5579960": {"added": 1790538343000, "file": {"name": "/ReadersScanner-v1.1.2.apk", "sha256": "82e4f9e0b68c351d2381d1041fcc622453297899299cf124f48ade02a5579960", "size": 40726724}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a"], "versionName": "1.1.2", "versionCode": 7, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 34}, "signer": {"sha256": ["b9c722e093f963ab7812922623e1c1a72fb9998537ad7d9aefa8b1a3f3a8120c"]}, "usesPermission": [{"name": "android.permission.CAMERA"}, {"name": "android.permission.INTERNET"}, {"name": "com.freedomfighter.readersscanner.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}]}, "antiFeatures": {"NonFreeDep": {"en-US": "If chosen at first start, Google ML Kit's document scanner runs through Google Play services."}, "Tracking": {"en-US": "Only with ML Kit chosen, Google's library sends usage statistics to Google (never the documents). The free engines send nothing."}, "UpstreamNonFree": {"en-US": "The app includes Google ML Kit (closed code), next to the free engines (Tesseract and its own page finder)."}}}}}}}